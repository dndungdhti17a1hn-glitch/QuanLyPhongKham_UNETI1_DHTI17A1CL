@model QuanLyPhongKham.Models.ViewModels.DichVuKhamEditViewModel

@{
    ViewData["Title"] = "Cập nhật dịch vụ khám";
}

<h2>Cập nhật dịch vụ khám</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="MaDichVu" />
            
            <div class="form-group mb-3">
                <label asp-for="MaDichVu" class="control-label"></label>
                <input asp-for="MaDichVu" class="form-control" disabled />
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="TenDichVu" class="control-label"></label>
                <input asp-for="TenDichVu" class="form-control" />
                <span asp-validation-for="TenDichVu" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GiaTien" class="control-label"></label>
                <input asp-for="GiaTien" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="GiaTien" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="MoTa" class="control-label"></label>
                <textarea asp-for="MoTa" class="form-control"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="TrangThai" class="control-label"></label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="1">Hoạt động</option>
                    <option value="0">Ngừng cung cấp</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
