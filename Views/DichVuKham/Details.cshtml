@model QuanLyPhongKham.Models.DichVuKham

@{
    ViewData["Title"] = "Chi tiết dịch vụ khám";
}

<h2>Chi tiết dịch vụ khám</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaDichVu)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaDichVu)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TenDichVu)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TenDichVu)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GiaTien)
        </dt>
        <dd class="col-sm-10">
            @Model.GiaTien.ToString("N0") VNĐ
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class="col-sm-10">
            @(Model.TrangThai == 1 ? "Hoạt động" : "Ngừng cung cấp")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.MaDichVu" class="btn btn-warning">Sửa</a> |
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
