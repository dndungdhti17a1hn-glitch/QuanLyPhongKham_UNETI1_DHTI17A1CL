@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-[75vh] bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8" style="font-family: 'Inter', sans-serif;">
    <div class="max-w-lg w-full bg-white rounded-3xl shadow-sm border border-slate-200 p-8 sm:p-10 text-center">
        <div class="w-20 h-20 mx-auto rounded-2xl bg-red-50 border border-red-100 flex items-center justify-center text-red-500 mb-6">
            <i class="fa-solid fa-shield-halved text-4xl"></i>
        </div>

        <span class="inline-block px-3 py-1 bg-red-100 text-red-700 text-xs font-bold rounded-full uppercase tracking-wider mb-3">
            403 - Forbidden
        </span>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">
            Không có quyền truy cập
        </h1>

        <p class="text-slate-500 text-sm sm:text-base leading-relaxed mb-8">
            Tài khoản của bạn không được cấp phép để thực hiện chức năng hoặc xem trang này. Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là nhầm lẫn.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="@Url.Action("Index", "Home")"
               class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm shadow-lg shadow-teal-500/25 transition">
                <i class="fa-solid fa-house mr-2"></i> Về trang chủ
            </a>
            <a href="@Url.Action("DangNhap", "TaiKhoan")"
               class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition">
                <i class="fa-solid fa-right-to-bracket mr-2"></i> Đăng nhập tài khoản khác
            </a>
        </div>
    </div>
</div>
