@model QuanLyPhongKham.Models.ViewModels.DangKyViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản - Phòng Khám Đa Khoa UN1";
}
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        medical: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .card-enter {
            animation: fadeUp 0.35s ease-out forwards;
        }
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .field-validation-error {
            display: block;
            margin-top: 0.375rem;
            font-size: 0.75rem;
            font-weight: 500;
            color: #dc2626;
        }
        .input-validation-error {
            border-color: #f87171 !important;
            background-color: #fef2f2 !important;
        }
    </style>
</head>
<body class="font-sans text-slate-800 bg-slate-50 antialiased selection:bg-medical-500 selection:text-white min-h-screen flex flex-col">

    <!-- Thông báo Toast -->
    <div id="toast" class="fixed top-20 right-5 z-50 hidden transform transition-all duration-300">
        <div class="bg-slate-900 text-white px-6 py-4 rounded-xl shadow-2xl flex items-center space-x-3 border-l-4 border-medical-500">
            <i id="toast-icon" class="fa-solid fa-circle-check text-medical-500 text-xl"></i>
            <div>
                <h4 id="toast-title" class="font-semibold text-sm">Thông báo</h4>
                <p id="toast-message" class="text-xs text-slate-300 mt-0.5"></p>
            </div>
        </div>
    </div>

    <!-- Thanh Điều Hướng (Navbar đồng bộ với Trang chủ) -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md shadow-sm border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <a href="@Url.Action("Index", "Home", new { view = "landing" })" class="flex items-center space-x-3 group">
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-medical-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-medical-500/20 group-hover:scale-105 transition">
                        <i class="fa-solid fa-staff-snake text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold bg-gradient-to-r from-medical-800 to-cyan-700 bg-clip-text text-transparent block leading-none">UN1</span>
                        <span class="text-xs text-slate-500 font-medium tracking-wider">CLINIC & HEALTHCARE</span>
                    </div>
                </a>

                <!-- Menu Desktop -->
                <nav class="hidden md:flex space-x-8 font-medium text-sm text-slate-600">
                    <a href="@Url.Action("Index", "Home", new { view = "landing" })" class="hover:text-medical-600 transition py-2">Trang chủ</a>
                    <a href="@Url.Action("Index", "Home", new { view = "landing" })#about" class="hover:text-medical-600 transition py-2">Về chúng tôi</a>
                    <a href="@Url.Action("TraCuu", "ChuyenKhoa")" class="hover:text-medical-600 transition py-2">Chuyên khoa</a>
                    <a href="@Url.Action("TraCuu", "DichVuKham")" class="hover:text-medical-600 transition py-2">Bảng giá dịch vụ</a>
                    <a href="@Url.Action("Index", "Home", new { view = "landing" })#doctors" class="hover:text-medical-600 transition py-2">Đội ngũ Bác sĩ</a>
                </nav>

                <!-- Cụm nút Điều hướng nhanh -->
                <div class="hidden md:flex items-center space-x-3">
                    <a href="@Url.Action("Index", "Home", new { view = "landing" })" class="px-4 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:text-medical-700 hover:bg-slate-100 transition">
                        <i class="fa-solid fa-arrow-left mr-1.5 text-xs"></i>Về trang chủ
                    </a>
                    <a href="@Url.Action("DangNhap", "TaiKhoan")" class="px-5 py-2.5 rounded-xl font-semibold text-sm text-medical-700 bg-medical-50 hover:bg-medical-100 border border-medical-200 transition">
                        <i class="fa-regular fa-user mr-1.5"></i>Đăng nhập
                    </a>
                </div>

                <!-- Nút Menu Mobile -->
                <div class="md:hidden flex items-center">
                    <a href="@Url.Action("Index", "Home", new { view = "landing" })" class="text-slate-600 hover:text-medical-600 px-3 py-2 rounded-lg text-sm font-medium">
                        <i class="fa-solid fa-house mr-1"></i>Trang chủ
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Phần Nội Dung Chính -->
    <main class="flex-grow relative overflow-hidden bg-gradient-to-b from-medical-50/70 via-white to-slate-50 py-10 lg:py-16 flex items-center">
        <!-- Họa tiết trang trí nền -->
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-medical-100/50 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-cyan-100/50 blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

                <!-- Cột Trái: Giới thiệu Quyền lợi Thành viên UN1 -->
                <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 bg-medical-100/80 text-medical-800 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide">
                        <span class="w-2 h-2 rounded-full bg-medical-600 animate-ping"></span>
                        <span>THẺ THÀNH VIÊN ĐIỆN TỬ MIỄN PHÍ</span>
                    </div>

                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        Khởi Tạo Hồ Sơ Sức Khỏe <br class="hidden sm:inline" />
                        <span class="bg-gradient-to-r from-medical-600 to-cyan-600 bg-clip-text text-transparent">Trực Tuyến Chỉ 1 Phút</span>
                    </h1>

                    <p class="text-base text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                        Trở thành thành viên của Phòng khám Đa khoa UN1 để tận hưởng quy trình tiếp đón ưu tiên không chờ đợi và quản lý sức khỏe toàn diện cho bản thân cùng gia đình.
                    </p>

                    <!-- Các quyền lợi khi đăng ký -->
                    <div class="space-y-3.5 pt-2 max-w-lg mx-auto lg:mx-0 text-left">
                        <div class="flex items-start space-x-3.5 bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-100 shadow-sm">
                            <div class="w-8 h-8 rounded-full bg-medical-100 text-medical-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <i class="fa-solid fa-check text-xs"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Đặt lịch khám ưu tiên 24/7</h4>
                                <p class="text-xs text-slate-500 mt-0.5">Chọn chuyên khoa, bác sĩ và khung giờ khám ngay trên điện thoại, không cần xếp hàng lấy số.</p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-3.5 bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-100 shadow-sm">
                            <div class="w-8 h-8 rounded-full bg-medical-100 text-medical-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <i class="fa-solid fa-check text-xs"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Tự động liên kết hồ sơ bệnh nhân</h4>
                                <p class="text-xs text-slate-500 mt-0.5">Tài khoản sau khi tạo sẽ tự động cấp Mã bệnh nhân riêng để lưu trữ lịch sử thăm khám trọn đời.</p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-3.5 bg-white/80 backdrop-blur p-4 rounded-2xl border border-slate-100 shadow-sm">
                            <div class="w-8 h-8 rounded-full bg-medical-100 text-medical-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <i class="fa-solid fa-check text-xs"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Hỗ trợ Bảo hiểm Y tế & Bảo lãnh viện phí</h4>
                                <p class="text-xs text-slate-500 mt-0.5">Chi phí công khai minh bạch, hưởng trọn quyền lợi BHYT và bảo hiểm thương mại.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Thẻ hỗ trợ nhanh -->
                    <div class="inline-flex items-center space-x-4 bg-white px-5 py-3.5 rounded-2xl shadow-md border border-slate-100 text-left">
                        <div class="w-11 h-11 rounded-xl bg-red-50 text-red-500 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-400 font-medium">Cần hỗ trợ đăng ký hồ sơ?</p>
                            <p class="text-sm font-bold text-slate-800">Tổng đài CSKH: <span class="text-medical-600">1900 888 999</span></p>
                        </div>
                    </div>
                </div>

                <!-- Cột Phải: Card Form Đăng Ký -->
                <div class="lg:col-span-6">
                    <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden card-enter max-w-lg mx-auto">

                        <!-- Header Card & Chuyển đổi Tab -->
                        <div class="p-6 sm:p-8 pb-0">
                            <div class="flex items-center justify-between mb-6">
                                <div class="flex items-center space-x-2.5">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-medical-600 to-cyan-500 text-white flex items-center justify-center shadow-md shadow-medical-500/20">
                                        <i class="fa-solid fa-user-plus"></i>
                                    </div>
                                    <div>
                                        <h2 class="font-bold text-lg text-slate-900 leading-tight">Đăng Ký Tài Khoản Mới</h2>
                                        <p class="text-xs text-slate-500">Dành cho Bệnh nhân & Khách hàng UN1</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Thanh chuyển Tab Đăng nhập / Đăng ký -->
                            <div class="grid grid-cols-2 bg-slate-100 p-1.5 rounded-xl mb-6">
                                <a href="@Url.Action("DangNhap", "TaiKhoan")" class="py-2.5 text-sm font-bold rounded-lg transition text-slate-600 hover:text-slate-900 text-center">
                                    Đăng nhập
                                </a>
                                <a href="@Url.Action("DangKy", "TaiKhoan")" class="py-2.5 text-sm font-bold rounded-lg transition bg-white text-medical-700 shadow-sm text-center">
                                    Đăng ký
                                </a>
                            </div>

                            <!-- Hiển thị Lỗi nếu có -->
                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="mb-5 p-4 rounded-xl bg-red-50 border border-red-200 flex items-start space-x-3 text-red-700 text-sm">
                                    <i class="fa-solid fa-circle-exclamation text-red-600 mt-0.5"></i>
                                    <span>@TempData["ErrorMessage"]</span>
                                </div>
                            }

                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                            {
                                <div class="mb-5 p-4 rounded-xl bg-red-50 border border-red-200 flex items-start space-x-3 text-red-700 text-sm">
                                    <i class="fa-solid fa-triangle-exclamation text-red-600 mt-0.5"></i>
                                    <span>@ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage</span>
                                </div>
                            }
                        </div>

                        <!-- Form Đăng Ký -->
                        <form asp-action="DangKy" asp-controller="TaiKhoan" method="post" class="px-6 sm:px-8 pb-8 space-y-4">
                            @Html.AntiForgeryToken()

                            <div>
                                <label asp-for="HoTen" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                    Họ và tên bệnh nhân <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <i class="fa-regular fa-id-card absolute left-3.5 top-3.5 text-slate-400"></i>
                                    <input asp-for="HoTen" placeholder="Ví dụ: Nguyễn Văn An" autocomplete="name"
                                           class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:border-medical-500 focus:ring-2 focus:ring-medical-500/20 outline-none text-sm transition" />
                                </div>
                                <span asp-validation-for="HoTen"></span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="TenDangNhap" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                        Tên đăng nhập <span class="text-red-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <i class="fa-regular fa-user absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                                        <input asp-for="TenDangNhap" placeholder="Viết liền không dấu" autocomplete="username"
                                               class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-200 focus:border-medical-500 focus:ring-2 focus:ring-medical-500/20 outline-none text-sm transition" />
                                    </div>
                                    <span asp-validation-for="TenDangNhap"></span>
                                </div>

                                <div>
                                    <label asp-for="Email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                        Địa chỉ Email <span class="text-red-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <i class="fa-regular fa-envelope absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                                        <input asp-for="Email" placeholder="email@domain.com" autocomplete="email"
                                               class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-200 focus:border-medical-500 focus:ring-2 focus:ring-medical-500/20 outline-none text-sm transition" />
                                    </div>
                                    <span asp-validation-for="Email"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="MatKhau" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                        Mật khẩu <span class="text-red-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <i class="fa-solid fa-lock absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                                        <input asp-for="MatKhau" id="reg-password" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password"
                                               class="w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-200 focus:border-medical-500 focus:ring-2 focus:ring-medical-500/20 outline-none text-sm transition" />
                                        <button type="button" onclick="togglePassword('reg-password', 'eye-pass')" tabindex="-1"
                                                class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 focus:outline-none">
                                            <i id="eye-pass" class="fa-regular fa-eye text-xs"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="MatKhau"></span>
                                </div>

                                <div>
                                    <label asp-for="XacNhanMatKhau" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                        Xác nhận MK <span class="text-red-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <i class="fa-solid fa-shield-halved absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                                        <input asp-for="XacNhanMatKhau" id="reg-confirm" placeholder="Nhập lại mật khẩu" autocomplete="new-password"
                                               class="w-full pl-9 pr-9 py-2.5 rounded-xl border border-slate-200 focus:border-medical-500 focus:ring-2 focus:ring-medical-500/20 outline-none text-sm transition" />
                                        <button type="button" onclick="togglePassword('reg-confirm', 'eye-confirm')" tabindex="-1"
                                                class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 focus:outline-none">
                                            <i id="eye-confirm" class="fa-regular fa-eye text-xs"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="XacNhanMatKhau"></span>
                                </div>
                            </div>

                            <div class="flex items-start space-x-2.5 pt-1">
                                <input type="checkbox" id="terms-check" required class="rounded text-medical-600 focus:ring-medical-500 border-slate-300 mt-0.5 cursor-pointer" />
                                <label for="terms-check" class="text-xs text-slate-600 leading-relaxed cursor-pointer">
                                    Tôi cam kết thông tin khai báo là chính xác và đồng ý với <span class="text-medical-600 font-semibold">Điều khoản dịch vụ</span> cùng <span class="text-medical-600 font-semibold">Chính sách bảo mật hồ sơ y tế</span> của Phòng khám UN1.
                                </label>
                            </div>

                            <button type="submit" class="w-full py-3.5 rounded-xl bg-medical-600 hover:bg-medical-700 text-white font-bold text-sm shadow-lg shadow-medical-500/25 flex items-center justify-center space-x-2 transition transform hover:-translate-y-0.5 mt-2">
                                <i class="fa-solid fa-user-check text-xs"></i>
                                <span>Tạo Tài Khoản Bệnh Nhân</span>
                            </button>

                            <div class="pt-4 border-t border-slate-100 text-center space-y-2">
                                <p class="text-xs text-slate-500">
                                    Đã có tài khoản tại hệ thống?
                                    <a asp-action="DangNhap" asp-controller="TaiKhoan" class="text-medical-600 font-bold hover:underline ml-1">
                                        Đăng nhập ngay
                                    </a>
                                </p>
                                <p class="text-xs text-slate-400">
                                    <a href="@Url.Action("Index", "Home", new { view = "landing" })" class="hover:text-medical-600 transition inline-flex items-center">
                                        <i class="fa-solid fa-house mr-1 text-[10px]"></i>Quay về trang chủ UN1
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Chân Trang rút gọn đồng bộ -->
    <footer class="bg-slate-900 text-slate-400 py-6 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
            <div class="flex items-center space-x-2.5">
                <div class="w-7 h-7 rounded-lg bg-medical-500 flex items-center justify-center text-white">
                    <i class="fa-solid fa-staff-snake text-xs"></i>
                </div>
                <span class="font-bold text-white">PHÒNG KHÁM ĐA KHOA UN1</span>
                <span class="text-slate-600">|</span>
                <span>&copy; 2026 Bảo lưu mọi quyền.</span>
            </div>
            <div class="flex items-center space-x-6">
                <span><i class="fa-solid fa-location-dot text-medical-500 mr-1.5"></i>128 Nguyễn Trãi, Thanh Xuân, Hà Nội</span>
                <span><i class="fa-solid fa-phone text-medical-500 mr-1.5"></i>Hotline: <strong class="text-white">1900 888 999</strong></span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
