@model QuanLyPhongKham.Models.ViewModels.TaiKhoanCreateViewModel
@using QuanLyPhongKham.Constants
@{
    ViewData["Title"] = "Thêm mới tài khoản";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8" style="font-family: 'Inter', sans-serif;">
    <div class="max-w-2xl mx-auto space-y-6">

        <div>
            <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-teal-600 transition">
                <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách tài khoản
            </a>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-100 bg-gradient-to-r from-teal-50/70 to-white flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-teal-600 text-white flex items-center justify-center shadow-md shadow-teal-500/20">
                    <i class="fa-solid fa-user-plus text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-slate-900">Thêm mới tài khoản</h1>
                    <p class="text-xs text-slate-500 mt-0.5">Khởi tạo tài khoản mới cho quản trị viên hoặc bệnh nhân</p>
                </div>
            </div>

            <form asp-action="Create" method="post" class="p-6 space-y-5">
                <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="MaTaiKhoan" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <input asp-for="MaTaiKhoan" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition" placeholder="VD: TK001" />
                        <span asp-validation-for="MaTaiKhoan" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="TenDangNhap" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <input asp-for="TenDangNhap" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition" placeholder="Nhập tên đăng nhập" />
                        <span asp-validation-for="TenDangNhap" class="text-xs text-red-600 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="MatKhau" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                    <input asp-for="MatKhau" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="MatKhau" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="HoTen" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <input asp-for="HoTen" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="HoTen" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <input asp-for="Email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition" placeholder="email@example.com" />
                        <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="VaiTro" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <select asp-for="VaiTro" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition">
                            <option value="@AppRoles.Patient">Bệnh nhân</option>
                            <option value="@AppRoles.Admin">Admin</option>
                        </select>
                        <span asp-validation-for="VaiTro" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="TrangThai" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                        <select asp-for="TrangThai" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 text-sm transition">
                            <option value="1">Hoạt động</option>
                            <option value="0">Khóa tài khoản</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-xs text-red-600 mt-1 block"></span>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition">
                        Quay lại
                    </a>
                    <button type="submit" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm shadow-lg shadow-teal-500/25 transition">
                        <i class="fa-solid fa-check mr-2"></i> Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
