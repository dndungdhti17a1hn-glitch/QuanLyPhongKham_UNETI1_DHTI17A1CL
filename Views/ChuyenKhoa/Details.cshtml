@model QuanLyPhongKham.Models.ChuyenKhoa

@{
    ViewData["Title"] = "Chi tiết chuyên khoa";
}

<h2>Chi tiết chuyên khoa</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaChuyenKhoa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaChuyenKhoa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TenChuyenKhoa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TenChuyenKhoa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MoTa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class="col-sm-10">
            @(Model.TrangThai == 1 ? "Hoạt động" : "Ngừng hoạt động")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.MaChuyenKhoa" class="btn btn-warning">Sửa</a> |
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
