@model QuanLyPhongKham.Models.ChuyenKhoa

@{
    ViewData["Title"] = "Xóa chuyên khoa";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8" style="font-family: 'Inter', sans-serif;">
    <div class="max-w-xl mx-auto space-y-6">

        <div>
            <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-slate-500 hover:text-teal-600 transition">
                <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách chuyên khoa
            </a>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-red-200 overflow-hidden">
            <div class="px-6 py-5 border-b border-red-100 bg-red-50/70 flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-red-600 text-white flex items-center justify-center shadow-md shadow-red-500/20">
                    <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-red-700">Xác nhận xóa chuyên khoa</h1>
                    <p class="text-xs text-red-600/90 mt-0.5">Bạn có chắc chắn muốn xóa chuyên khoa này khỏi hệ thống?</p>
                </div>
            </div>

            <div class="p-6 divide-y divide-slate-100">
                <div class="py-3 grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <span class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.MaChuyenKhoa)</span>
                    <span class="sm:col-span-2 font-mono text-sm font-semibold text-slate-900">@Html.DisplayFor(model => model.MaChuyenKhoa)</span>
                </div>
                <div class="py-3 grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <span class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.TenChuyenKhoa)</span>
                    <span class="sm:col-span-2 text-sm font-bold text-slate-900">@Html.DisplayFor(model => model.TenChuyenKhoa)</span>
                </div>
                <div class="py-3 grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <span class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.MoTa)</span>
                    <span class="sm:col-span-2 text-sm text-slate-600">@(string.IsNullOrEmpty(Model.MoTa) ? "—" : Model.MoTa)</span>
                </div>
            </div>

            <form asp-action="Delete" class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-3">
                <input type="hidden" asp-for="MaChuyenKhoa" />
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition">
                    Hủy bỏ
                </a>
                <button type="submit" class="inline-flex items-center px-6 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-sm shadow-lg shadow-red-500/25 transition">
                    <i class="fa-regular fa-trash-can mr-2"></i> Xác nhận xóa
                </button>
            </form>
        </div>
    </div>
</div>
