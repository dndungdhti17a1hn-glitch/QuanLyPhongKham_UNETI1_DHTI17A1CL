@model QuanLyPhongKham.Models.ViewModels.LichSuKhamTraCuuViewModel

@{
    ViewData["Title"] = "Tra cứu Lịch sử Khám bệnh & Hồ sơ Bệnh án";
    var danhSachBacSi = ViewBag.DanhSachBacSi as List<QuanLyPhongKham.Models.BacSi> ?? new List<QuanLyPhongKham.Models.BacSi>();
}

<div class="container-fluid mt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-1">📂 Tra Cứu Lịch Sử Khám Bệnh & Hồ Sơ Y Tế</h2>
            <p class="text-muted mb-0">Module 4 - Mục 8.7: Bảo toàn lịch sử khám (Không Delete), Truy vấn theo Bệnh nhân và Bác sĩ</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="KhamBenh" asp-action="Index" class="btn btn-outline-primary">
                🩺 Tiếp nhận & Khám
            </a>
            <a asp-controller="ThanhToan" asp-action="Index" class="btn btn-outline-success">
                💳 Quản lý Thu ngân
            </a>
        </div>
    </div>

    <!-- Thông báo nguyên tắc 8.7 -->
    <div class="alert alert-info border-info d-flex align-items-center shadow-sm mb-4" role="alert">
        <span class="fs-3 me-3">🛡️</span>
        <div>
            <strong>Nguyên tắc Bảo toàn lịch sử (8.7):</strong> Toàn bộ dữ liệu Lịch hẹn, Phiếu khám bệnh, Chi tiết chỉ định dịch vụ và Hóa đơn thu viện phí được bảo lưu trọn vẹn, <strong>tuyệt đối không áp dụng thao tác xóa (Hard Delete)</strong> nhằm phục vụ đối soát, tra cứu tiền sử bệnh án lâu dài.
        </div>
    </div>

    <!-- Bộ lọc tìm kiếm theo Bệnh nhân / Bác sĩ -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="card-title mb-0 fw-bold text-dark">🔍 Công cụ truy vấn hồ sơ lịch sử</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Đối tượng tra cứu:</label>
                    <select name="loaiTraCuu" id="selectLoaiTraCuu" class="form-select" onchange="toggleForm()">
                        <option value="BenhNhan" selected="@(Model.LoaiTraCuu == "BenhNhan")">👤 Theo Bệnh nhân (Tên, SĐT, Mã BN)</option>
                        <option value="BacSi" selected="@(Model.LoaiTraCuu == "BacSi")">👨‍⚕️ Theo Bác sĩ phụ trách</option>
                    </select>
                </div>

                <!-- Input tìm theo Bệnh nhân -->
                <div class="col-md-6" id="divBenhNhan" style="@(Model.LoaiTraCuu == "BacSi" ? "display:none;" : "")">
                    <label class="form-label fw-bold">Nhập thông tin bệnh nhân:</label>
                    <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" placeholder="Nhập Họ tên, Số điện thoại (ví dụ: 0912345678) hoặc Mã BN..." />
                </div>

                <!-- Input chọn Bác sĩ -->
                <div class="col-md-6" id="divBacSi" style="@(Model.LoaiTraCuu == "BacSi" ? "" : "display:none;")">
                    <label class="form-label fw-bold">Chọn bác sĩ:</label>
                    <select name="bacSiId" class="form-select">
                        <option value="">-- Chọn bác sĩ cần xem lịch sử --</option>
                        @foreach (var bs in danhSachBacSi)
                        {
                            <option value="@bs.MaBacSi" selected="@(Model.SelectedBacSiId == bs.MaBacSi)">
                                @bs.HoTen (@(bs.ChuyenKhoa?.TenChuyenKhoa ?? "Đa khoa")) - Mã: @bs.MaBacSi
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        🔍 Truy vấn lịch sử
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning">@ViewBag.Message</div>
    }

    <!-- KẾT QUẢ THEO BỆNH NHÂN -->
    @if (Model.LoaiTraCuu == "BenhNhan" && Model.BenhNhanThongTin != null)
    {
        <!-- Thẻ thông tin bệnh nhân -->
        <div class="card shadow-sm border-primary border-opacity-25 mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-2 text-center mb-3 mb-md-0">
                        <div class="display-3">👤</div>
                        <span class="badge bg-primary">Mã BN: @Model.BenhNhanThongTin.MaBenhNhan</span>
                    </div>
                    <div class="col-md-10">
                        <h4 class="text-primary fw-bold mb-2">@Model.BenhNhanThongTin.HoTen</h4>
                        <div class="row g-2">
                            <div class="col-sm-4"><strong>Số điện thoại:</strong> 📞 @Model.BenhNhanThongTin.SoDienThoai</div>
                            <div class="col-sm-4"><strong>Giới tính:</strong> @Model.BenhNhanThongTin.GioiTinh</div>
                            <div class="col-sm-4"><strong>Ngày sinh:</strong> @(Model.BenhNhanThongTin.NgaySinh.HasValue ? Model.BenhNhanThongTin.NgaySinh.Value.ToString("dd/MM/yyyy") : "---")</div>
                            <div class="col-sm-8"><strong>Địa chỉ:</strong> @Model.BenhNhanThongTin.DiaChi</div>
                            <div class="col-sm-4"><strong>Email:</strong> @Model.BenhNhanThongTin.Email</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng lịch sử khám bệnh của bệnh nhân -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    📋 Toàn bộ lịch sử các lần đến khám (@Model.DanhSachLichHen.Count() đợt)
                </h5>
                <span class="badge bg-success">Bảo toàn vĩnh viễn</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã lịch hẹn</th>
                                <th>Thời gian</th>
                                <th>Bác sĩ & Chuyên khoa</th>
                                <th>Chẩn đoán & Kết luận</th>
                                <th>Dịch vụ y tế thực hiện</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Viện phí</th>
                                <th class="text-center pe-3">Hồ sơ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DanhSachLichHen.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <em>Bệnh nhân chưa có lịch sử khám bệnh nào trên hệ thống.</em>
                                    </td>
                                </tr>
                            }
                            @foreach (var lh in Model.DanhSachLichHen)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@lh.MaLichHen</td>
                                    <td>
                                        <div>@lh.NgayKham.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@lh.GioKham.ToString(@"hh\:mm")</small>
                                    </td>
                                    <td>
                                        <div>@lh.BacSi?.HoTen</div>
                                        <small class="text-muted">@(lh.BacSi?.ChuyenKhoa?.TenChuyenKhoa ?? "Đa khoa")</small>
                                    </td>
                                    <td>
                                        @if (lh.PhieuKham != null)
                                        {
                                            <div class="fw-semibold text-dark">@lh.PhieuKham.ChanDoan</div>
                                            <small class="text-muted">KL: @lh.PhieuKham.KetLuan</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Lý do: @lh.LyDoKham</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lh.PhieuKham?.ChiTietDichVus != null && lh.PhieuKham.ChiTietDichVus.Any())
                                        {
                                            @foreach (var dv in lh.PhieuKham.ChiTietDichVus)
                                            {
                                                <span class="badge bg-light text-dark border d-inline-block mb-1">
                                                    @dv.DichVuKham?.TenDichVu (x@dv.SoLuong)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <small class="text-muted">---</small>
                                        }
                                    </td>
                                    <td>
                                        @if (lh.TrangThai == "Hoàn tất")
                                        {
                                            <span class="badge bg-success">Hoàn tất</span>
                                        }
                                        else if (lh.TrangThai == "Đã hủy")
                                        {
                                            <span class="badge bg-danger" title="@lh.LyDoHuy">Đã hủy</span>
                                            @if (!string.IsNullOrEmpty(lh.LyDoHuy))
                                            {
                                                <div><small class="text-danger fst-italic">(@lh.LyDoHuy)</small></div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">@lh.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">
                                        @if (lh.PhieuKham?.ThanhToan != null)
                                        {
                                            <span class="text-success">@lh.PhieuKham.ThanhToan.SoTien.ToString("N0") đ</span>
                                            <div><small class="text-muted">(@lh.PhieuKham.ThanhToan.PhuongThuc)</small></div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (lh.PhieuKham != null)
                                        {
                                            <a asp-controller="KhamBenh" asp-action="ChiTietPhieuKham" asp-route-id="@lh.PhieuKham.MaPhieuKham" class="btn btn-sm btn-outline-primary mb-1">
                                                📄 Phiếu
                                            </a>
                                        }
                                        @if (lh.PhieuKham?.ThanhToan != null)
                                        {
                                            <a asp-controller="ThanhToan" asp-action="HoaDon" asp-route-id="@lh.PhieuKham.ThanhToan.MaThanhToan" class="btn btn-sm btn-outline-success">
                                                🧾 HĐ
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- KẾT QUẢ THEO BÁC SĨ -->
    @if (Model.LoaiTraCuu == "BacSi" && Model.BacSiThongTin != null)
    {
        <!-- Thẻ thông tin bác sĩ -->
        <div class="card shadow-sm border-info border-opacity-25 mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-2 text-center mb-3 mb-md-0">
                        <div class="display-3">👨‍⚕️</div>
                        <span class="badge bg-info text-dark">Mã BS: @Model.BacSiThongTin.MaBacSi</span>
                    </div>
                    <div class="col-md-10">
                        <h4 class="text-dark fw-bold mb-2">@Model.BacSiThongTin.HoTen</h4>
                        <div class="row g-2">
                            <div class="col-sm-4"><strong>Chuyên khoa:</strong> <span class="badge bg-primary">@(Model.BacSiThongTin.ChuyenKhoa?.TenChuyenKhoa ?? "Đa khoa")</span></div>
                            <div class="col-sm-4"><strong>Trạng thái:</strong> <span class="badge bg-success">@Model.BacSiThongTin.TrangThai</span></div>
                            <div class="col-sm-4"><strong>Tổng ca phụ trách:</strong> <span class="fw-bold fs-6 text-primary">@Model.DanhSachLichHen.Count() ca</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng danh sách ca khám của bác sĩ -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    📋 Lịch sử khám bệnh do Bác sĩ phụ trách
                </h5>
                <span class="badge bg-success">Bảo toàn vĩnh viễn</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã lịch</th>
                                <th>Thời gian</th>
                                <th>Bệnh nhân</th>
                                <th>Số điện thoại</th>
                                <th>Chẩn đoán & Kết luận</th>
                                <th>Trạng thái</th>
                                <th class="text-center pe-3">Xem chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.DanhSachLichHen.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <em>Bác sĩ chưa có ca khám nào được ghi nhận trong lịch sử.</em>
                                    </td>
                                </tr>
                            }
                            @foreach (var lh in Model.DanhSachLichHen)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">@lh.MaLichHen</td>
                                    <td>
                                        <div>@lh.NgayKham.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@lh.GioKham.ToString(@"hh\:mm")</small>
                                    </td>
                                    <td class="fw-bold">@lh.BenhNhan?.HoTen</td>
                                    <td>📞 @lh.BenhNhan?.SoDienThoai</td>
                                    <td>
                                        @if (lh.PhieuKham != null)
                                        {
                                            <div class="fw-semibold">@lh.PhieuKham.ChanDoan</div>
                                            <small class="text-muted">KL: @lh.PhieuKham.KetLuan</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">@lh.LyDoKham</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lh.TrangThai == "Hoàn tất")
                                        {
                                            <span class="badge bg-success">Hoàn tất</span>
                                        }
                                        else if (lh.TrangThai == "Đã hủy")
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">@lh.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (lh.PhieuKham != null)
                                        {
                                            <a asp-controller="KhamBenh" asp-action="ChiTietPhieuKham" asp-route-id="@lh.PhieuKham.MaPhieuKham" class="btn btn-sm btn-outline-primary">
                                                📄 Phiếu khám
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleForm() {
            var val = document.getElementById('selectLoaiTraCuu').value;
            if (val === 'BenhNhan') {
                document.getElementById('divBenhNhan').style.display = 'block';
                document.getElementById('divBacSi').style.display = 'none';
            } else {
                document.getElementById('divBenhNhan').style.display = 'none';
                document.getElementById('divBacSi').style.display = 'block';
            }
        }
    </script>
}
