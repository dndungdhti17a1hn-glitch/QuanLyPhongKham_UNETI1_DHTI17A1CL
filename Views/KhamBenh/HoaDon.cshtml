@model QuanLyPhongKham.Models.ThanhToan

@{
    ViewData["Title"] = "Hóa đơn thanh toán - " + Model.MaThanhToan;
    var phieu = Model.PhieuKham;
    var lich = phieu?.LichHen;
    var bn = lich?.BenhNhan;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    @@media print {
        header, footer, .no-print {
            display: none !important;
        }
        body {
            background-color: white !important;
            padding: 0 !important;
        }
        .invoice-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>

<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto space-y-6">

        <!-- Top Actions -->
        <div class="flex items-center justify-between no-print">
            <a asp-action="Index" class="inline-flex items-center text-sm font-semibold text-slate-600 hover:text-teal-600 transition">
                <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại danh sách lịch hẹn
            </a>
            <div class="flex items-center gap-3">
                <button onclick="window.print()" class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-semibold shadow transition">
                    <i class="fa-solid fa-print mr-2"></i> In hóa đơn / Lưu PDF
                </button>
            </div>
        </div>

        <!-- Hóa đơn / Biên lai khổ chuẩn (Invoice Card) -->
        <div class="bg-white p-8 sm:p-12 rounded-3xl shadow-sm border border-slate-200 invoice-card space-y-8">
            
            <!-- Đầu hóa đơn -->
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 border-b border-slate-200 pb-8">
                <div>
                    <div class="flex items-center gap-2 text-teal-600 font-extrabold text-xl tracking-tight">
                        <i class="fa-solid fa-heart-pulse text-2xl"></i> PHÒNG KHÁM UNETI
                    </div>
                    <p class="text-xs text-slate-500 mt-1">Hệ thống Y tế & Quản lý lịch hẹn khám bệnh Đề tài 39</p>
                    <p class="text-xs text-slate-500">Địa chỉ: 218 Lĩnh Nam, Hoàng Mai, Hà Nội</p>
                    <p class="text-xs text-slate-500">Hotline: 1900 1234 - Website: unetimedical.vn</p>
                </div>
                <div class="sm:text-right">
                    <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full uppercase tracking-wider mb-2">
                        <i class="fa-solid fa-circle-check mr-1"></i> ĐÃ THANH TOÁN
                    </span>
                    <h2 class="text-2xl font-black text-slate-900 tracking-tight">HÓA ĐƠN VIỆN PHÍ</h2>
                    <p class="text-xs text-slate-500 mt-1">Mã hóa đơn: <strong class="text-slate-800">@Model.MaThanhToan</strong></p>
                    <p class="text-xs text-slate-500">Ngày lập: @Model.NgayThanhToan.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Thông tin khách hàng & Phiếu khám -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs text-slate-600 bg-slate-50/70 p-5 rounded-2xl border border-slate-100">
                <div class="space-y-1.5">
                    <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wider mb-2">Thông tin Bệnh nhân</h4>
                    <p><strong class="text-slate-700">Họ và tên:</strong> <span class="font-bold text-slate-900 text-sm">@bn?.HoTen</span></p>
                    <p><strong class="text-slate-700">Mã bệnh nhân:</strong> @bn?.MaBenhNhan</p>
                    <p><strong class="text-slate-700">Số điện thoại:</strong> @bn?.SoDienThoai</p>
                    <p><strong class="text-slate-700">Giới tính:</strong> @bn?.GioiTinh - <strong class="text-slate-700">Ngày sinh:</strong> @(bn?.NgaySinh?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                    <p><strong class="text-slate-700">Địa chỉ:</strong> @(bn?.DiaChi ?? "Hà Nội")</p>
                </div>
                <div class="space-y-1.5 sm:border-l sm:border-slate-200 sm:pl-6">
                    <h4 class="font-bold text-slate-900 text-sm uppercase tracking-wider mb-2">Chi tiết Lần khám</h4>
                    <p><strong class="text-slate-700">Bác sĩ khám:</strong> @lich?.BacSi?.HoTen</p>
                    <p><strong class="text-slate-700">Phòng khám:</strong> @lich?.PhongKham?.TenPhong</p>
                    <p><strong class="text-slate-700">Mã phiếu khám:</strong> @phieu?.MaPhieuKham</p>
                    <p><strong class="text-slate-700">Chẩn đoán:</strong> <span class="font-semibold text-slate-800">@phieu?.ChanDoan</span></p>
                    <p><strong class="text-slate-700">Kết luận:</strong> @phieu?.KetLuan</p>
                </div>
            </div>

            <!-- Bảng danh sách dịch vụ chi tiết -->
            <div class="space-y-4">
                <table class="min-w-full text-left text-xs divide-y divide-slate-200">
                    <thead class="bg-slate-50 font-bold text-slate-700 uppercase">
                        <tr>
                            <th class="py-3 px-3">STT</th>
                            <th class="py-3 px-3">Nội dung dịch vụ khám</th>
                            <th class="py-3 px-3 text-center">Số lượng</th>
                            <th class="py-3 px-3 text-right">Đơn giá</th>
                            <th class="py-3 px-3 text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @if (phieu?.ChiTietDichVus != null && phieu.ChiTietDichVus.Any())
                        {
                            int stt = 1;
                            @foreach (var item in phieu.ChiTietDichVus)
                            {
                                <tr>
                                    <td class="py-3 px-3 text-slate-400 font-mono">@(stt++)</td>
                                    <td class="py-3 px-3 font-semibold text-slate-900">@item.DichVuKham?.TenDichVu</td>
                                    <td class="py-3 px-3 text-center">@item.SoLuong</td>
                                    <td class="py-3 px-3 text-right">@item.DonGia.ToString("N0") đ</td>
                                    <td class="py-3 px-3 text-right font-bold text-slate-900">@item.ThanhTien.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="py-3 px-3 text-slate-400 font-mono">1</td>
                                <td class="py-3 px-3 font-semibold text-slate-900">Khám lâm sàng nội chuyên khoa</td>
                                <td class="py-3 px-3 text-center">1</td>
                                <td class="py-3 px-3 text-right">@Model.SoTien.ToString("N0") đ</td>
                                <td class="py-3 px-3 text-right font-bold text-slate-900">@Model.SoTien.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Tổng cộng tiền & Phương thức thanh toán -->
            <div class="border-t border-slate-200 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs">
                <div class="space-y-1">
                    <p><strong class="text-slate-800">Phương thức thanh toán:</strong> <span class="font-semibold text-slate-900">@Model.PhuongThuc</span></p>
                    <p><strong class="text-slate-800">Trạng thái:</strong> <span class="text-emerald-700 font-bold">@Model.TrangThai</span></p>
                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <p class="text-slate-500 italic">Ghi chú: @Model.GhiChu</p>
                    }
                </div>
                <div class="text-right">
                    <span class="text-slate-500 text-xs block">TỔNG TIỀN THANH TOÁN:</span>
                    <span class="text-3xl font-black text-emerald-600">@Model.SoTien.ToString("N0") đ</span>
                </div>
            </div>

            <!-- Chữ ký -->
            <div class="grid grid-cols-2 text-center text-xs pt-8 border-t border-slate-100 text-slate-600">
                <div>
                    <p class="font-bold text-slate-800">BỆNH NHÂN</p>
                    <p class="text-[11px] text-slate-400 italic mt-0.5">(Ký và ghi rõ họ tên)</p>
                    <div class="h-16"></div>
                    <p class="font-semibold text-slate-700">@bn?.HoTen</p>
                </div>
                <div>
                    <p class="font-bold text-slate-800">NGƯỜI THU TIỀN / THU NGÂN</p>
                    <p class="text-[11px] text-slate-400 italic mt-0.5">(Ký và đóng dấu)</p>
                    <div class="h-16"></div>
                    <p class="font-semibold text-slate-700">Bộ phận Thu ngân UNETI</p>
                </div>
            </div>

        </div>

    </div>
</div>
