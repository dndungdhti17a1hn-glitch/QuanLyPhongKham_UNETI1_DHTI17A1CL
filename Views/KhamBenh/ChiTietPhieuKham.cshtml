@model QuanLyPhongKham.Models.PhieuKham

@{
    ViewData["Title"] = "Chi tiết Phiếu khám bệnh - " + Model.MaPhieuKham;
    decimal tongTien = Model.ChiTietDichVus.Sum(c => c.ThanhTien);
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Quản lý Khám</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết Phiếu khám</li>
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary">
                🖨️ In phiếu khám
            </button>
            @if (Model.ThanhToan == null || Model.ThanhToan.TrangThai != "Đã thanh toán")
            {
                <a asp-controller="ThanhToan" asp-action="ThanhToan" asp-route-maPhieuKham="@Model.MaPhieuKham" class="btn btn-success fw-bold">
                    💳 Tiến hành Thanh toán
                </a>
            }
            else
            {
                <a asp-controller="ThanhToan" asp-action="HoaDon" asp-route-id="@Model.ThanhToan.MaThanhToan" class="btn btn-outline-success">
                    🧾 Xem Hóa đơn thu tiền
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-primary">Danh sách</a>
        </div>
    </div>

    <!-- Phiếu khám bệnh y tế tiêu chuẩn -->
    <div class="card shadow-sm border-0 mb-4 printable-area">
        <div class="card-body p-4 p-md-5">
            <!-- Header phòng khám -->
            <div class="row pb-3 mb-4 border-bottom align-items-center">
                <div class="col-sm-7">
                    <h4 class="text-primary fw-bold mb-1">PHÒNG KHÁM ĐA KHOA QUỐC TẾ UNETI</h4>
                    <p class="text-muted small mb-0">Địa chỉ: 218 Lĩnh Nam, Hoàng Mai, Hà Nội | Hotline: 1900 6868</p>
                </div>
                <div class="col-sm-5 text-sm-end mt-2 mt-sm-0">
                    <h3 class="fw-bold text-dark mb-0">PHIẾU KHÁM BỆNH</h3>
                    <div class="text-muted">Mã số: <strong class="text-primary">@Model.MaPhieuKham</strong></div>
                    <div class="text-muted small">Mã lịch hẹn: @Model.MaLichHen</div>
                </div>
            </div>

            <!-- Thông tin Bệnh nhân & Bác sĩ -->
            <div class="row g-3 mb-4 p-3 bg-light rounded">
                <div class="col-md-4">
                    <span class="text-muted small">Họ và tên bệnh nhân:</span>
                    <div class="fw-bold fs-5 text-dark">@Model.LichHen?.BenhNhan?.HoTen</div>
                    <small class="text-muted">Mã BN: @Model.LichHen?.MaBenhNhan</small>
                </div>
                <div class="col-md-2">
                    <span class="text-muted small">Giới tính / Tuổi:</span>
                    <div class="fw-semibold">
                        @Model.LichHen?.BenhNhan?.GioiTinh
                        @if (Model.LichHen?.BenhNhan?.NgaySinh.HasValue == true)
                        {
                            <span>(@(DateTime.Now.Year - Model.LichHen.BenhNhan.NgaySinh.Value.Year) tuổi)</span>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Số điện thoại:</span>
                    <div class="fw-semibold">@Model.LichHen?.BenhNhan?.SoDienThoai</div>
                    <small class="text-muted text-truncate d-block">@Model.LichHen?.BenhNhan?.DiaChi</small>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Bác sĩ phụ trách:</span>
                    <div class="fw-bold text-primary">@Model.LichHen?.BacSi?.HoTen</div>
                    <small class="text-muted">@Model.LichHen?.PhongKham?.TenPhong</small>
                </div>
            </div>

            <!-- Kết quả chẩn đoán lâm sàng -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-white">
                        <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">🩺 Chẩn đoán bệnh:</h6>
                        <p class="fs-6 text-dark" style="white-space: pre-line;">@Model.ChanDoan</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-white">
                        <h6 class="text-success fw-bold border-bottom pb-2 mb-3">📋 Kết luận & Lời dặn bác sĩ:</h6>
                        <p class="fs-6 text-dark" style="white-space: pre-line;">@Model.KetLuan</p>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.GhiChu))
            {
                <div class="alert alert-secondary py-2 mb-4">
                    <strong>Ghi chú:</strong> @Model.GhiChu
                </div>
            }

            <!-- Dịch vụ y tế thực tế chỉ định -->
            <div class="mb-4">
                <h6 class="text-dark fw-bold mb-3">💉 Chi tiết Dịch vụ y tế thực tế chỉ định:</h6>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">STT</th>
                                <th>Tên dịch vụ</th>
                                <th class="text-center" style="width: 100px;">Số lượng</th>
                                <th class="text-end" style="width: 150px;">Đơn giá</th>
                                <th class="text-end" style="width: 160px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ChiTietDichVus.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Không có chỉ định dịch vụ kỹ thuật thêm.</td>
                                </tr>
                            }
                            else
                            {
                                int stt = 1;
                                foreach (var ct in Model.ChiTietDichVus)
                                {
                                    <tr>
                                        <td class="text-center">@(stt++)</td>
                                        <td class="fw-semibold">@ct.DichVuKham?.TenDichVu</td>
                                        <td class="text-center">@ct.SoLuong</td>
                                        <td class="text-end">@ct.DonGia.ToString("N0") đ</td>
                                        <td class="text-end fw-bold text-primary">@ct.ThanhTien.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4" class="text-end fs-6">Tổng chi phí dịch vụ:</th>
                                <th class="text-end fs-5 text-danger fw-bold">@tongTien.ToString("N0") VNĐ</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Trạng thái thanh toán -->
            <div class="p-3 rounded mb-4 @(Model.ThanhToan != null && Model.ThanhToan.TrangThai == "Đã thanh toán" ? "bg-success bg-opacity-10 border border-success" : "bg-warning bg-opacity-10 border border-warning")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold">Tình trạng thanh toán: </span>
                        @if (Model.ThanhToan != null && Model.ThanhToan.TrangThai == "Đã thanh toán")
                        {
                            <span class="badge bg-success fs-6">Đã thanh toán đủ</span>
                            <span class="text-muted ms-2">(Mã HĐ: @Model.ThanhToan.MaThanhToan - Ngày: @Model.ThanhToan.NgayThanhToan.ToString("dd/MM/yyyy HH:mm") - Phương thức: @Model.ThanhToan.PhuongThuc)</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6">Chưa thanh toán (Chờ thu ngân)</span>
                        }
                    </div>
                    @if (Model.ThanhToan == null || Model.ThanhToan.TrangThai != "Đã thanh toán")
                    {
                        <a asp-controller="ThanhToan" asp-action="ThanhToan" asp-route-maPhieuKham="@Model.MaPhieuKham" class="btn btn-sm btn-success fw-bold">
                            Thu tiền ngay
                        </a>
                    }
                </div>
            </div>

            <!-- Chữ ký -->
            <div class="row pt-4 text-center mt-5">
                <div class="col-6">
                    <p class="mb-1 fw-bold">BỆNH NHÂN / NGƯỜI NHÀ</p>
                    <small class="text-muted">(Ký và ghi rõ họ tên)</small>
                </div>
                <div class="col-6">
                    <p class="mb-1 text-muted small">Ngày @Model.NgayKham.ToString("dd") tháng @Model.NgayKham.ToString("MM") năm @Model.NgayKham.ToString("yyyy")</p>
                    <p class="mb-1 fw-bold">BÁC SĨ KHÁM BỆNH</p>
                    <small class="text-muted">(Ký, đóng dấu chức danh)</small>
                    <div style="height: 60px;"></div>
                    <div class="fw-bold text-primary">@Model.LichHen?.BacSi?.HoTen</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .printable-area, .printable-area * {
            visibility: visible;
        }
        .printable-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        .btn, nav, header, footer {
            display: none !important;
        }
    }
</style>
