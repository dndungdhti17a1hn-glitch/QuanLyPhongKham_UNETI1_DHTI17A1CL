@model QuanLyPhongKham.Models.ViewModels.ThanhToanViewModel

@{
    ViewData["Title"] = "Thanh toán viện phí - " + Model.MaPhieuKham;
    var phieu = Model.PhieuKham;
    var lich = phieu?.LichHen;
    var bn = lich?.BenhNhan;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-6">

        <!-- Navigation Breadcrumb -->
        <div class="flex items-center space-x-2 text-sm text-slate-500">
            <a asp-action="Index" class="hover:text-teal-600 transition">Quản lý Lịch hẹn</a>
            <i class="fa-solid fa-chevron-right text-xs"></i>
            <span class="text-slate-900 font-semibold">Thu ngân & Thanh toán viện phí</span>
        </div>

        <!-- Header -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-semibold rounded-full uppercase tracking-wider mb-2">Mục 8.3 - Thu Ngân Viện Phí</span>
                <h1 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-cash-register text-emerald-600"></i> Thanh Toán Viện Phí
                </h1>
                <p class="text-slate-500 text-sm mt-1">Tính tiền từ dịch vụ thực tế, kiểm tra chống thanh toán hai lần và phát hành biên lai.</p>
            </div>
            <div class="text-right">
                <span class="text-xs text-slate-400 block">Mã phiếu khám:</span>
                <span class="text-lg font-bold text-teal-700">@Model.MaPhieuKham</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- Cột trái: Thông tin Bệnh nhân & Chi tiết dịch vụ thực tế (2 cols) -->
            <div class="md:col-span-2 space-y-6">
                
                <!-- Bệnh nhân -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3">
                        <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-user-circle text-teal-600"></i> Thông tin bệnh nhân
                        </h3>
                        <span class="text-xs px-2.5 py-1 bg-slate-100 text-slate-700 rounded-full font-medium">
                            Mã BN: @bn?.MaBenhNhan
                        </span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-xs text-slate-600">
                        <div><strong class="text-slate-800">Họ và tên:</strong> @bn?.HoTen</div>
                        <div><strong class="text-slate-800">Số điện thoại:</strong> @bn?.SoDienThoai</div>
                        <div><strong class="text-slate-800">Giới tính:</strong> @bn?.GioiTinh</div>
                        <div><strong class="text-slate-800">Bác sĩ khám:</strong> @lich?.BacSi?.HoTen</div>
                    </div>
                    <div class="mt-3 pt-3 border-t border-slate-100 text-xs">
                        <strong class="text-slate-800">Chẩn đoán:</strong> 
                        <span class="text-slate-700">@phieu?.ChanDoan</span>
                    </div>
                </div>

                <!-- Bảng chi tiết dịch vụ thực tế (Quy định 8.3) -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-4">
                    <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2 border-b border-slate-100 pb-3">
                        <i class="fa-solid fa-file-invoice-dollar text-emerald-600"></i> Chi tiết dịch vụ sử dụng thực tế
                    </h3>

                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-xs divide-y divide-slate-100">
                            <thead class="text-slate-500 uppercase bg-slate-50">
                                <tr>
                                    <th class="py-2.5 px-3">Tên dịch vụ</th>
                                    <th class="py-2.5 px-3 text-center">SL</th>
                                    <th class="py-2.5 px-3 text-right">Đơn giá</th>
                                    <th class="py-2.5 px-3 text-right">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @if (phieu?.ChiTietDichVus != null && phieu.ChiTietDichVus.Any())
                                {
                                    @foreach (var item in phieu.ChiTietDichVus)
                                    {
                                        <tr>
                                            <td class="py-3 px-3 font-semibold text-slate-800">
                                                @item.DichVuKham?.TenDichVu
                                            </td>
                                            <td class="py-3 px-3 text-center text-slate-600">@item.SoLuong</td>
                                            <td class="py-3 px-3 text-right text-slate-600">@item.DonGia.ToString("N0") đ</td>
                                            <td class="py-3 px-3 text-right font-bold text-slate-900">@item.ThanhTien.ToString("N0") đ</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td class="py-3 px-3 font-semibold text-slate-800">Khám lâm sàng nội tổng quát</td>
                                        <td class="py-3 px-3 text-center text-slate-600">1</td>
                                        <td class="py-3 px-3 text-right text-slate-600">150,000 đ</td>
                                        <td class="py-3 px-3 text-right font-bold text-slate-900">150,000 đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- Cột phải: Form xác nhận thanh toán (1 col) -->
            <div class="space-y-6">
                <form asp-action="ThanhToan" method="post" class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-5">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaPhieuKham" />
                    <input type="hidden" asp-for="TongTien" />

                    <div class="border-b border-slate-100 pb-4">
                        <span class="text-xs text-slate-500 uppercase font-bold tracking-wider block">Tổng tiền thanh toán</span>
                        <div class="text-3xl font-extrabold text-emerald-600 mt-1">
                            @Model.TongTien.ToString("N0") <span class="text-lg">đ</span>
                        </div>
                    </div>

                    <!-- Phương thức thanh toán -->
                    <div class="space-y-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase">Phương thức thanh toán <span class="text-rose-500">*</span></label>
                        <div class="space-y-2">
                            <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 hover:border-emerald-500 cursor-pointer transition">
                                <input type="radio" asp-for="PhuongThuc" value="Tiền mặt" checked class="text-emerald-600 focus:ring-emerald-500" />
                                <span class="text-xs font-semibold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-money-bill-wave text-emerald-600"></i> Tiền mặt
                                </span>
                            </label>
                            <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 hover:border-emerald-500 cursor-pointer transition">
                                <input type="radio" asp-for="PhuongThuc" value="Chuyển khoản QR" class="text-emerald-600 focus:ring-emerald-500" />
                                <span class="text-xs font-semibold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-qrcode text-blue-600"></i> Chuyển khoản QR
                                </span>
                            </label>
                            <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 hover:border-emerald-500 cursor-pointer transition">
                                <input type="radio" asp-for="PhuongThuc" value="Thẻ tín dụng / ATM" class="text-emerald-600 focus:ring-emerald-500" />
                                <span class="text-xs font-semibold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-credit-card text-purple-600"></i> Thẻ ATM / POS
                                </span>
                            </label>
                        </div>
                    </div>

                    <!-- Ghi chú thanh toán -->
                    <div class="space-y-2">
                        <label asp-for="GhiChu" class="block text-xs font-bold text-slate-700 uppercase">Ghi chú biên lai</label>
                        <textarea asp-for="GhiChu" rows="2" placeholder="Ví dụ: Bệnh nhân đã thanh toán đủ tiền mặt..." 
                                  class="w-full text-xs border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
                    </div>

                    <!-- Cảnh báo chống thanh toán 2 lần -->
                    <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-[11px] text-amber-800 flex items-start gap-2">
                        <i class="fa-solid fa-shield-halved text-amber-600 text-sm mt-0.5 flex-shrink-0"></i>
                        <span>Ràng buộc hệ thống: Hệ thống kiểm soát không cho phép thanh toán 2 lần cho cùng một phiếu khám.</span>
                    </div>

                    <button type="submit" class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-lg shadow-emerald-500/30 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check-double"></i> Xác Nhận Thu Tiền
                    </button>
                    <a asp-action="Index" class="block text-center text-xs text-slate-500 hover:text-slate-800 py-1 transition">
                        Hủy bỏ & Quay lại
                    </a>
                </form>
            </div>

        </div>

    </div>
</div>
