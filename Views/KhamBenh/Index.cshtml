@model QuanLyPhongKham.Models.ViewModels.LichHenFilterViewModel

@{
    ViewData["Title"] = "Quản lý Lịch hẹn & Tiếp nhận khám";
}

<!-- Tailwind CSS & FontAwesome -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Toast Thông báo -->
@if (TempData["SuccessMessage"] != null)
{
    <div id="toast-success" class="fixed top-20 right-5 z-50 animate-bounce">
        <div class="bg-emerald-600 text-white px-6 py-4 rounded-xl shadow-2xl flex items-center space-x-3">
            <i class="fa-solid fa-circle-check text-2xl"></i>
            <div>
                <p class="font-bold">Thành công</p>
                <p class="text-sm opacity-90">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    </div>
    <script>setTimeout(() => document.getElementById('toast-success')?.remove(), 4000);</script>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="toast-error" class="fixed top-20 right-5 z-50 animate-bounce">
        <div class="bg-red-600 text-white px-6 py-4 rounded-xl shadow-2xl flex items-center space-x-3">
            <i class="fa-solid fa-triangle-exclamation text-2xl"></i>
            <div>
                <p class="font-bold">Lưu ý</p>
                <p class="text-sm opacity-90">@TempData["ErrorMessage"]</p>
            </div>
        </div>
    </div>
    <script>setTimeout(() => document.getElementById('toast-error')?.remove(), 5000);</script>
}

<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Top Header & Action -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <div>
                <span class="inline-block px-3 py-1 bg-teal-100 text-teal-800 text-xs font-semibold rounded-full uppercase tracking-wider mb-2">Module 4 - Quản lý Tiếp nhận & Khám</span>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-stethoscope text-teal-600"></i> Quản Lý Lịch Hẹn & Khám Bệnh
                </h1>
                <p class="text-slate-500 text-sm mt-1">Xác nhận lịch hẹn, tiếp nhận bệnh nhân, lập phiếu khám, chỉ định dịch vụ và thanh toán viện phí.</p>
            </div>
            <div class="flex items-center gap-3">
                <a asp-controller="ThongKe" asp-action="Index" class="inline-flex items-center px-4 py-2.5 rounded-xl border border-teal-600 text-teal-700 bg-teal-50 hover:bg-teal-100 font-medium text-sm transition">
                    <i class="fa-solid fa-chart-pie mr-2"></i> Dashboard Thống Kê
                </a>
            </div>
        </div>

        <!-- Bộ lọc & Tìm kiếm (Filter & Search Form) -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <!-- 1. Search text -->
                <div class="lg:col-span-2">
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Tìm kiếm</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Tên BN, SĐT, Bác sĩ, Mã LH..." 
                               class="w-full pl-10 pr-4 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none" />
                    </div>
                </div>

                <!-- 2. Lọc trạng thái -->
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Trạng thái</label>
                    <select name="trangThai" class="w-full py-2 px-3 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Chờ xác nhận" selected="@(Model.TrangThai == "Chờ xác nhận")">🟡 Chờ xác nhận</option>
                        <option value="Đã xác nhận" selected="@(Model.TrangThai == "Đã xác nhận")">🔵 Đã xác nhận</option>
                        <option value="Đã tiếp nhận" selected="@(Model.TrangThai == "Đã tiếp nhận")">🟣 Đã tiếp nhận</option>
                        <option value="Hoàn tất" selected="@(Model.TrangThai == "Hoàn tất")">🟢 Hoàn tất</option>
                        <option value="Đã hủy" selected="@(Model.TrangThai == "Đã hủy")">🔴 Đã hủy</option>
                    </select>
                </div>

                <!-- 3. Lọc bác sĩ -->
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Bác sĩ phụ trách</label>
                    <select name="maBacSi" class="w-full py-2 px-3 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:outline-none">
                        <option value="">-- Tất cả bác sĩ --</option>
                        @foreach (var bs in Model.DanhSachBacSi)
                        {
                            <option value="@bs.MaBacSi" selected="@(Model.MaBacSi == bs.MaBacSi)">@bs.HoTen</option>
                        }
                    </select>
                </div>

                <!-- 4. Lọc ngày & Sắp xếp -->
                <div class="flex items-end gap-2">
                    <button type="submit" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2 px-4 rounded-xl text-sm transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-filter"></i> Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="bg-slate-100 hover:bg-slate-200 text-slate-600 py-2 px-3 rounded-xl text-sm transition" title="Xóa bộ lọc">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>

                <!-- Hàng tùy chọn phụ: Ngày khám & Sắp xếp -->
                <div class="lg:col-span-5 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100 text-xs text-slate-500">
                    <div class="flex items-center gap-3">
                        <span class="font-medium">Ngày khám:</span>
                        <input type="date" name="ngayKham" value="@(Model.NgayKham?.ToString("yyyy-MM-dd"))" 
                               class="py-1 px-2 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-teal-500" />
                        
                        <span class="font-medium ml-2">Sắp xếp:</span>
                        <select name="sortOrder" onchange="this.form.submit()" class="py-1 px-2 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-teal-500">
                            <option value="date_desc" selected="@(Model.SortOrder == "date_desc")">Ngày khám: Mới nhất</option>
                            <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Ngày khám: Cũ nhất</option>
                            <option value="patient_asc" selected="@(Model.SortOrder == "patient_asc")">Bệnh nhân: A - Z</option>
                            <option value="patient_desc" selected="@(Model.SortOrder == "patient_desc")">Bệnh nhân: Z - A</option>
                            <option value="status" selected="@(Model.SortOrder == "status")">Theo trạng thái</option>
                        </select>
                    </div>
                    <div>
                        Tìm thấy <strong class="text-teal-700 font-bold">@Model.TotalItems</strong> lịch hẹn
                    </div>
                </div>
            </form>
        </div>

        <!-- Bảng danh sách lịch hẹn -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                    <thead class="bg-slate-50 font-bold text-slate-700 uppercase tracking-wider text-xs">
                        <tr>
                            <th class="py-3.5 px-4">Mã LH / Thời gian</th>
                            <th class="py-3.5 px-4">Bệnh nhân</th>
                            <th class="py-3.5 px-4">Bác sĩ & Phòng khám</th>
                            <th class="py-3.5 px-4">Lý do khám</th>
                            <th class="py-3.5 px-4 text-center">Trạng thái</th>
                            <th class="py-3.5 px-4 text-center">Hồ sơ khám & Phí</th>
                            <th class="py-3.5 px-4 text-right">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="py-12 text-center text-slate-500">
                                    <i class="fa-regular fa-folder-open text-4xl text-slate-300 mb-3 block"></i>
                                    Không có dữ liệu lịch hẹn nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr class="hover:bg-slate-50/70 transition">
                                    <!-- 1. Mã & Ngày giờ -->
                                    <td class="py-3.5 px-4 whitespace-nowrap">
                                        <div class="font-bold text-slate-900">@item.MaLichHen</div>
                                        <div class="text-xs text-teal-700 font-semibold flex items-center gap-1 mt-0.5">
                                            <i class="fa-regular fa-clock"></i> @item.GioKham.ToString(@"hh\:mm") - @item.NgayKham.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>

                                    <!-- 2. Bệnh nhân -->
                                    <td class="py-3.5 px-4">
                                        <div class="font-bold text-slate-800">@item.BenhNhan?.HoTen</div>
                                        <div class="text-xs text-slate-500 flex items-center gap-2 mt-0.5">
                                            <span><i class="fa-solid fa-phone text-slate-400"></i> @item.BenhNhan?.SoDienThoai</span>
                                            <span>• @item.BenhNhan?.GioiTinh</span>
                                        </div>
                                    </td>

                                    <!-- 3. Bác sĩ & Phòng -->
                                    <td class="py-3.5 px-4">
                                        <div class="font-semibold text-slate-800 flex items-center gap-1">
                                            <i class="fa-solid fa-user-doctor text-teal-600"></i> @item.BacSi?.HoTen
                                        </div>
                                        <div class="text-xs text-slate-500 mt-0.5">
                                            <i class="fa-solid fa-door-open text-slate-400"></i> @item.PhongKham?.TenPhong
                                        </div>
                                    </td>

                                    <!-- 4. Lý do khám -->
                                    <td class="py-3.5 px-4 max-w-xs">
                                        <p class="text-xs text-slate-700 truncate" title="@item.LyDoKham">
                                            @(string.IsNullOrEmpty(item.LyDoKham) ? "Khám bệnh định kỳ" : item.LyDoKham)
                                        </p>
                                        @if (!string.IsNullOrEmpty(item.GhiChu))
                                        {
                                            <p class="text-[11px] text-amber-700 truncate mt-0.5" title="@item.GhiChu">
                                                <i class="fa-solid fa-triangle-exclamation"></i> @item.GhiChu
                                            </p>
                                        }
                                    </td>

                                    <!-- 5. Trạng thái -->
                                    <td class="py-3.5 px-4 text-center whitespace-nowrap">
                                        @switch (item.TrangThai)
                                        {
                                            case "Chờ xác nhận":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span> Chờ xác nhận
                                                </span>
                                                break;
                                            case "Đã xác nhận":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-1.5"></span> Đã xác nhận
                                                </span>
                                                break;
                                            case "Đã tiếp nhận":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-purple-500 mr-1.5"></span> Đã tiếp nhận
                                                </span>
                                                break;
                                            case "Hoàn tất":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Hoàn tất
                                                </span>
                                                break;
                                            case "Đã hủy":
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span> Đã hủy
                                                </span>
                                                break;
                                            default:
                                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800">@item.TrangThai</span>
                                                break;
                                        }
                                    </td>

                                    <!-- 6. Hồ sơ khám & Thanh toán -->
                                    <td class="py-3.5 px-4 text-center whitespace-nowrap text-xs">
                                        @if (item.PhieuKham != null)
                                        {
                                            <span class="font-semibold text-teal-700 block">
                                                <i class="fa-solid fa-file-medical"></i> @item.PhieuKham.MaPhieuKham
                                            </span>
                                            @if (item.PhieuKham.ThanhToan != null)
                                            {
                                                <span class="inline-block mt-0.5 px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">
                                                    @item.PhieuKham.ThanhToan.SoTien.ToString("N0") đ
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-block mt-0.5 px-2 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold">
                                                    Chờ thanh toán
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 italic">Chưa có phiếu</span>
                                        }
                                    </td>

                                    <!-- 7. Hành động nghiệp vụ -->
                                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <!-- Chi tiết luôn xem được -->
                                            <a asp-action="ChiTiet" asp-route-id="@item.MaLichHen" 
                                               class="p-2 text-slate-600 hover:text-teal-600 hover:bg-slate-100 rounded-lg transition" title="Xem hồ sơ chi tiết">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>

                                            <!-- 8.2 Nghiệp vụ Xác nhận -->
                                            @if (item.TrangThai == "Chờ xác nhận")
                                            {
                                                <form asp-action="XacNhan" asp-route-id="@item.MaLichHen" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold transition" title="Xác nhận lịch hẹn">
                                                        <i class="fa-solid fa-check mr-1"></i> Xác nhận
                                                    </button>
                                                </form>
                                            }

                                            <!-- 8.2 Nghiệp vụ Tiếp nhận -->
                                            @if (item.TrangThai == "Đã xác nhận")
                                            {
                                                <form asp-action="TiepNhan" asp-route-id="@item.MaLichHen" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="px-3 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-semibold transition" title="Tiếp nhận bệnh nhân đến phòng">
                                                        <i class="fa-solid fa-hospital-user mr-1"></i> Tiếp nhận
                                                    </button>
                                                </form>
                                            }

                                            <!-- 8.1 & 8.2 Nghiệp vụ Khám bệnh -->
                                            @if (item.TrangThai == "Đã tiếp nhận")
                                            {
                                                <a asp-action="Kham" asp-route-id="@item.MaLichHen" 
                                                   class="px-3 py-1.5 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-xs font-semibold transition">
                                                    <i class="fa-solid fa-stethoscope mr-1"></i> Vào Khám
                                                </a>
                                            }

                                            <!-- 8.3 Nghiệp vụ Thanh toán -->
                                            @if (item.TrangThai == "Hoàn tất" && item.PhieuKham != null)
                                            {
                                                @if (item.PhieuKham.ThanhToan == null)
                                                {
                                                    <a asp-action="ThanhToan" asp-route-maPhieuKham="@item.PhieuKham.MaPhieuKham" 
                                                       class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold transition">
                                                        <i class="fa-solid fa-credit-card mr-1"></i> Thu tiền
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="HoaDon" asp-route-maThanhToan="@item.PhieuKham.ThanhToan.MaThanhToan" 
                                                       class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition" title="Xem Hóa đơn">
                                                        <i class="fa-solid fa-receipt mr-1"></i> Hóa đơn
                                                    </a>
                                                }
                                            }

                                            <!-- 8.4 Nghiệp vụ Hủy lịch (Chỉ khi Cho phép: Chờ xác nhận hoặc Đã xác nhận) -->
                                            @if (item.TrangThai == "Chờ xác nhận" || item.TrangThai == "Đã xác nhận")
                                            {
                                                <button type="button" onclick="openHuyModal('@item.MaLichHen', '@item.BenhNhan?.HoTen')" 
                                                        class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg transition" title="Hủy lịch hẹn">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang LINQ (Pagination) -->
            @if (Model.TotalPages > 1)
            {
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
                    <div class="text-slate-600">
                        Hiển thị trang <span class="font-bold text-slate-800">@Model.PageIndex</span> / <span class="font-bold text-slate-800">@Model.TotalPages</span> 
                        (Tổng cộng @Model.TotalItems kết quả)
                    </div>
                    <div class="flex items-center gap-1">
                        <!-- Trang trước -->
                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-trangThai="@Model.TrangThai" 
                               asp-route-maBacSi="@Model.MaBacSi" 
                               asp-route-ngayKham="@(Model.NgayKham?.ToString("yyyy-MM-dd"))" 
                               asp-route-sortOrder="@Model.SortOrder" 
                               asp-route-pageIndex="@(Model.PageIndex - 1)" 
                               class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-medium transition">
                                <i class="fa-solid fa-chevron-left mr-1"></i> Trước
                            </a>
                        }

                        <!-- Danh sách các số trang -->
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.PageIndex)
                            {
                                <span class="px-3.5 py-1.5 rounded-lg bg-teal-600 text-white font-bold">@p</span>
                            }
                            else if (p == 1 || p == Model.TotalPages || (p >= Model.PageIndex - 2 && p <= Model.PageIndex + 2))
                            {
                                <a asp-action="Index" 
                                   asp-route-searchTerm="@Model.SearchTerm" 
                                   asp-route-trangThai="@Model.TrangThai" 
                                   asp-route-maBacSi="@Model.MaBacSi" 
                                   asp-route-ngayKham="@(Model.NgayKham?.ToString("yyyy-MM-dd"))" 
                                   asp-route-sortOrder="@Model.SortOrder" 
                                   asp-route-pageIndex="@p" 
                                   class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 transition">@p</a>
                            }
                            else if (p == Model.PageIndex - 3 || p == Model.PageIndex + 3)
                            {
                                <span class="px-2 text-slate-400">...</span>
                            }
                        }

                        <!-- Trang sau -->
                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-trangThai="@Model.TrangThai" 
                               asp-route-maBacSi="@Model.MaBacSi" 
                               asp-route-ngayKham="@(Model.NgayKham?.ToString("yyyy-MM-dd"))" 
                               asp-route-sortOrder="@Model.SortOrder" 
                               asp-route-pageIndex="@(Model.PageIndex + 1)" 
                               class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 font-medium transition">
                                Sau <i class="fa-solid fa-chevron-right ml-1"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Hủy lịch hẹn (Quy định 8.4: Chỉ hủy khi cho phép & Lưu lý do) -->
<div id="modalHuyLich" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all animate-scale-up">
        <div class="p-6">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-xl mb-4">
                <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Xác nhận Hủy lịch hẹn</h3>
            <p class="text-sm text-slate-500 mt-1">
                Bạn đang thực hiện hủy lịch hẹn cho bệnh nhân <strong id="modalBenhNhanName" class="text-slate-800"></strong>. Hành động này sẽ được lưu vào lịch sử hệ thống.
            </p>

            <form asp-action="HuyLich" method="post" class="mt-4 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaLichHen" id="modalMaLichHen" />

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Lý do hủy lịch <span class="text-rose-500">*</span></label>
                    <textarea name="LyDoHuy" rows="3" required placeholder="Nhập lý do hủy (ví dụ: Bệnh nhân bận việc đột xuất, xin dời ngày...)" 
                              class="w-full text-sm border border-slate-300 rounded-xl p-3 focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="button" onclick="closeHuyModal()" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-semibold transition">
                        Đóng
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold shadow-lg shadow-rose-500/30 transition">
                        <i class="fa-solid fa-ban mr-1.5"></i> Hủy lịch ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openHuyModal(maLichHen, tenBenhNhan) {
        document.getElementById('modalMaLichHen').value = maLichHen;
        document.getElementById('modalBenhNhanName').innerText = tenBenhNhan || maLichHen;
        document.getElementById('modalHuyLich').classList.remove('hidden');
    }
    function closeHuyModal() {
        document.getElementById('modalHuyLich').classList.add('hidden');
    }
</script>
