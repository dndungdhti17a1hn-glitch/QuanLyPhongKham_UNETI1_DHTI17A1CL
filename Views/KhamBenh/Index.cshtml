@model IEnumerable<QuanLyPhongKham.Models.LichHen>

@{
    ViewData["Title"] = "Quản lý Tiếp nhận và Khám bệnh";
    string currentStatus = ViewBag.CurrentStatus as string ?? "TatCa";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary fw-bold mb-1">🏥 Quản lý Tiếp nhận & Khám bệnh</h2>
            <p class="text-muted mb-0">Module 4: Xử lý quy trình từ Tiếp nhận ➔ Khám bệnh ➔ Lập phiếu khám ➔ Chờ thanh toán</p>
        </div>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary me-2">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-controller="ThanhToan" asp-action="Index" class="btn btn-success">
                <i class="bi bi-cash-stack"></i> Quản lý Thanh toán
            </a>
        </div>
    </div>

    <!-- Thông báo Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <strong>Thông báo:</strong> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh lọc và tìm kiếm -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="status" value="@currentStatus" />
                <div class="col-md-5">
                    <label class="form-label fw-bold">Tìm kiếm theo tên BN, SĐT, Bác sĩ, Mã lịch:</label>
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Nhập từ khóa tìm kiếm..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Ngày khám:</label>
                    <input type="date" name="searchDate" value="@ViewBag.SearchDate" class="form-control" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">🔍 Lọc dữ liệu</button>
                    <a asp-action="Index" asp-route-status="@currentStatus" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Navigation Tabs theo trạng thái -->
    <ul class="nav nav-pills mb-3 border-bottom pb-2">
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "TatCa" ? "active" : "")" asp-action="Index" asp-route-status="TatCa" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Tất cả <span class="badge bg-secondary ms-1">@Model.Count()</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Chờ xác nhận" ? "active bg-warning text-dark" : "")" asp-action="Index" asp-route-status="Chờ xác nhận" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Chờ xác nhận <span class="badge bg-warning text-dark ms-1">@ViewBag.CountChoXacNhan</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đã xác nhận" ? "active bg-info text-dark" : "")" asp-action="Index" asp-route-status="Đã xác nhận" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Đã xác nhận (Chờ tiếp nhận) <span class="badge bg-info text-dark ms-1">@ViewBag.CountDaXacNhan</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đã tiếp nhận" ? "active bg-primary" : "")" asp-action="Index" asp-route-status="Đã tiếp nhận" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Đã tiếp nhận (Chờ khám) <span class="badge bg-light text-primary ms-1">@ViewBag.CountDaTiepNhan</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Chờ thanh toán" ? "active bg-secondary text-white" : "")" asp-action="Index" asp-route-status="Chờ thanh toán" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Chờ thanh toán <span class="badge bg-light text-dark ms-1">@ViewBag.CountChoThanhToan</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Hoàn tất" ? "active bg-success" : "")" asp-action="Index" asp-route-status="Hoàn tất" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Hoàn tất <span class="badge bg-light text-success ms-1">@ViewBag.CountHoanTat</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đã hủy" ? "active bg-danger" : "")" asp-action="Index" asp-route-status="Đã hủy" asp-route-searchString="@ViewBag.SearchString" asp-route-searchDate="@ViewBag.SearchDate">
                Đã hủy <span class="badge bg-light text-danger ms-1">@ViewBag.CountDaHuy</span>
            </a>
        </li>
    </ul>

    <!-- Bảng dữ liệu danh sách lịch hẹn -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã lịch</th>
                            <th>Bệnh nhân</th>
                            <th>Bác sĩ & Khoa</th>
                            <th>Phòng</th>
                            <th>Thời gian hẹn</th>
                            <th>Lý do khám</th>
                            <th>Trạng thái</th>
                            <th class="text-center pe-3">Thao tác nghiệp vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <em>Không có lịch hẹn nào phù hợp với bộ lọc hiện tại.</em>
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@item.MaLichHen</td>
                                <td>
                                    <div class="fw-bold">@item.BenhNhan?.HoTen</div>
                                    <small class="text-muted">📞 @item.BenhNhan?.SoDienThoai</small>
                                </td>
                                <td>
                                    <div>@item.BacSi?.HoTen</div>
                                    <small class="badge bg-light text-dark border">@(item.BacSi?.ChuyenKhoa?.TenChuyenKhoa ?? "Đa khoa")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.PhongKham?.TenPhong</span>
                                </td>
                                <td>
                                    <div>📅 @item.NgayKham.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">⏰ @item.GioKham.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <span title="@item.LyDoKham">
                                        @(item.LyDoKham != null && item.LyDoKham.Length > 30 ? item.LyDoKham.Substring(0, 30) + "..." : item.LyDoKham)
                                    </span>
                                </td>
                                <td>
                                    @if (item.TrangThai == "Chờ xác nhận")
                                    {
                                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                    }
                                    else if (item.TrangThai == "Đã xác nhận")
                                    {
                                        <span class="badge bg-info text-dark">Đã xác nhận</span>
                                    }
                                    else if (item.TrangThai == "Đã tiếp nhận")
                                    {
                                        <span class="badge bg-primary">Đã tiếp nhận</span>
                                    }
                                    else if (item.TrangThai == "Chờ thanh toán")
                                    {
                                        <span class="badge bg-secondary">Chờ thanh toán</span>
                                    }
                                    else if (item.TrangThai == "Hoàn tất")
                                    {
                                        <span class="badge bg-success">Hoàn tất</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="Lý do: @item.LyDoHuy">Đã hủy</span>
                                        @if (!string.IsNullOrEmpty(item.LyDoHuy))
                                        {
                                            <div><small class="text-danger fst-italic">(@item.LyDoHuy)</small></div>
                                        }
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @* 8.2: Duyệt/Xác nhận lịch hẹn *@
                                        @if (item.TrangThai == "Chờ xác nhận")
                                        {
                                            <form asp-action="XacNhan" asp-route-id="@item.MaLichHen" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Xác nhận lịch">
                                                    ✓ Duyệt lịch
                                                </button>
                                            </form>
                                        }

                                        @* 8.2: Tiếp nhận bệnh nhân (Chỉ khi Đã xác nhận) *@
                                        @if (item.TrangThai == "Đã xác nhận")
                                        {
                                            <form asp-action="TiepNhan" asp-route-id="@item.MaLichHen" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-primary" title="Tiếp nhận vào phòng khám">
                                                    📥 Tiếp nhận
                                                </button>
                                            </form>
                                        }

                                        @* 8.1 & 8.2: Lập phiếu khám (Chỉ khi Đã tiếp nhận) *@
                                        @if (item.TrangThai == "Đã tiếp nhận")
                                        {
                                            <a asp-action="LapPhieuKham" asp-route-id="@item.MaLichHen" class="btn btn-success fw-bold" title="Lập phiếu khám bệnh">
                                                🩺 Lập phiếu khám
                                            </a>
                                        }

                                        @* Chờ thanh toán: Chuyển sang thanh toán *@
                                        @if (item.TrangThai == "Chờ thanh toán" && item.PhieuKham != null)
                                        {
                                            <a asp-controller="ThanhToan" asp-action="ThanhToan" asp-route-maPhieuKham="@item.PhieuKham.MaPhieuKham" class="btn btn-warning text-dark fw-bold">
                                                💳 Thu tiền
                                            </a>
                                            <a asp-action="ChiTietPhieuKham" asp-route-id="@item.PhieuKham.MaPhieuKham" class="btn btn-outline-info">
                                                📄 Xem phiếu
                                            </a>
                                        }

                                        @* Đã hoàn tất: Xem phiếu & Hóa đơn *@
                                        @if (item.TrangThai == "Hoàn tất" && item.PhieuKham != null)
                                        {
                                            <a asp-action="ChiTietPhieuKham" asp-route-id="@item.PhieuKham.MaPhieuKham" class="btn btn-outline-primary" title="Xem phiếu khám">
                                                📄 Phiếu khám
                                            </a>
                                            @if (item.PhieuKham.ThanhToan != null)
                                            {
                                                <a asp-controller="ThanhToan" asp-action="HoaDon" asp-route-id="@item.PhieuKham.ThanhToan.MaThanhToan" class="btn btn-outline-success" title="Xem hóa đơn">
                                                    🧾 Hóa đơn
                                                </a>
                                            }
                                        }

                                        @* 8.4: Hủy lịch (Chỉ cho phép khi Chờ xác nhận hoặc Đã xác nhận) *@
                                        @if (item.TrangThai == "Chờ xác nhận" || item.TrangThai == "Đã xác nhận")
                                        {
                                            <button type="button" class="btn btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#modalHuyLich" data-malich="@item.MaLichHen" data-tenbn="@item.BenhNhan?.HoTen">
                                                ❌ Hủy lịch
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal 8.4: Nhập lý do hủy lịch -->
<div class="modal fade" id="modalHuyLich" tabindex="-1" aria-labelledby="modalHuyLichLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="HuyLich" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalHuyLichLabel">Xác nhận Hủy lịch hẹn</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="maLichHen" id="modalMaLichHen" />
                    <p>Bạn đang thực hiện hủy lịch hẹn cho bệnh nhân: <strong id="modalTenBN" class="text-primary"></strong></p>
                    <div class="alert alert-warning small mb-3">
                        <i class="bi bi-exclamation-triangle"></i> <strong>Lưu ý (8.4 & 8.7):</strong> Lịch hẹn sau khi hủy sẽ được bảo toàn thông tin và lưu trữ trong lịch sử, không xóa khỏi hệ thống.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Lý do hủy lịch <span class="text-danger">*</span>:</label>
                        <textarea name="lyDoHuy" class="form-control" rows="3" required placeholder="Nhập lý do hủy lịch khám (ví dụ: Bệnh nhân báo bận, Bác sĩ có ca mổ khẩn cấp, Trùng lịch...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy lịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var modalHuyLich = document.getElementById('modalHuyLich');
        if (modalHuyLich) {
            modalHuyLich.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var maLich = button.getAttribute('data-malich');
                var tenBN = button.getAttribute('data-tenbn');
                
                document.getElementById('modalMaLichHen').value = maLich;
                document.getElementById('modalTenBN').textContent = tenBN + ' (' + maLich + ')';
            });
        }
    </script>
}
