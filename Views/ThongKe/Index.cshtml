@model QuanLyPhongKham.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - Tổng quan Phòng Khám";
}

<!-- Tailwind CSS & FontAwesome & Chart.js -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-6">

        <!-- Top Header -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <span class="inline-block px-3 py-1 bg-teal-100 text-teal-800 text-xs font-semibold rounded-full uppercase tracking-wider mb-2">Module 4 - Dashboard & Thống Kê</span>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-chart-line text-teal-600"></i> Dashboard Phòng Khám
                </h1>
                <p class="text-slate-500 text-sm mt-1">Giám sát tổng thể hoạt động, lượt khám, bác sĩ, lịch hẹn và doanh thu thực tế.</p>
            </div>
            <div class="flex items-center gap-3">
                <a asp-action="BaoCao" class="inline-flex items-center px-4 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm shadow-lg shadow-teal-500/30 transition">
                    <i class="fa-solid fa-file-lines mr-2"></i> Báo Cáo LINQ Chuyên Sâu
                </a>
                <a asp-controller="KhamBenh" asp-action="Index" class="inline-flex items-center px-4 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm transition">
                    <i class="fa-solid fa-stethoscope mr-2"></i> Khám & Tiếp nhận
                </a>
            </div>
        </div>

        <!-- KPI Cards Grid (Mục 8.5) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 1. Tổng bệnh nhân -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-13 h-13 w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Tổng Bệnh Nhân</span>
                    <span class="text-2xl font-black text-slate-900">@Model.TongBenhNhan</span>
                </div>
            </div>

            <!-- 2. Tổng Bác sĩ & Phòng -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-user-doctor"></i>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Đội ngũ Bác sĩ</span>
                    <span class="text-2xl font-black text-slate-900">@Model.TongBacSi</span>
                    <span class="text-xs text-slate-400 ml-1">(@Model.TongPhongKham phòng)</span>
                </div>
            </div>

            <!-- 3. Lịch hẹn hoàn tất -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Lượt Khám Hoàn Tất</span>
                    <span class="text-2xl font-black text-slate-900">@Model.SoLichHoanTat</span>
                    <span class="text-xs text-slate-400 ml-1">/ @Model.TongLichHen lịch</span>
                </div>
            </div>

            <!-- 4. Tổng doanh thu -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-600 flex items-center justify-center text-xl flex-shrink-0">
                    <i class="fa-solid fa-sack-dollar"></i>
                </div>
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Tổng Doanh Thu</span>
                    <span class="text-2xl font-black text-emerald-600">@Model.TongDoanhThu.ToString("N0") <span class="text-xs">đ</span></span>
                </div>
            </div>
        </div>

        <!-- Trạng thái Lịch hẹn phân bổ (Cards phụ) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="bg-amber-50 p-4 rounded-xl border border-amber-200">
                <span class="text-xs font-bold text-amber-800 uppercase block">Chờ xác nhận</span>
                <span class="text-2xl font-black text-amber-700 mt-1 block">@Model.SoLichChoXacNhan</span>
            </div>
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-200">
                <span class="text-xs font-bold text-blue-800 uppercase block">Đã xác nhận</span>
                <span class="text-2xl font-black text-blue-700 mt-1 block">@Model.SoLichDaXacNhan</span>
            </div>
            <div class="bg-purple-50 p-4 rounded-xl border border-purple-200">
                <span class="text-xs font-bold text-purple-800 uppercase block">Đã tiếp nhận</span>
                <span class="text-2xl font-black text-purple-700 mt-1 block">@Model.SoLichDaTiepNhan</span>
            </div>
            <div class="bg-rose-50 p-4 rounded-xl border border-rose-200">
                <span class="text-xs font-bold text-rose-800 uppercase block">Đã hủy</span>
                <span class="text-2xl font-black text-rose-700 mt-1 block">@Model.SoLichDaHuy</span>
            </div>
        </div>

        <!-- Biểu đồ & Top Bác sĩ -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Biểu đồ Donut Tỷ lệ Hoàn tất / Hủy -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col justify-between">
                <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2 border-b border-slate-100 pb-3">
                    <i class="fa-solid fa-chart-pie text-teal-600"></i> Tỷ Lệ Hoàn Tất & Hủy Lịch
                </h3>
                <div class="py-4 relative flex items-center justify-center" style="height: 220px;">
                    <canvas id="chartTyLeLich"></canvas>
                </div>
                <div class="grid grid-cols-2 gap-2 text-center text-xs pt-3 border-t border-slate-100">
                    <div class="p-2 bg-emerald-50 rounded-lg">
                        <span class="text-emerald-700 font-bold block">@Model.TyLeHoanTat%</span>
                        <span class="text-slate-500">Hoàn tất</span>
                    </div>
                    <div class="p-2 bg-rose-50 rounded-lg">
                        <span class="text-rose-700 font-bold block">@Model.TyLeHuy%</span>
                        <span class="text-slate-500">Đã hủy</span>
                    </div>
                </div>
            </div>

            <!-- Top Bác sĩ có nhiều lượt khám nhất (2 cols) -->
            <div class="lg:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                        <i class="fa-solid fa-ranking-star text-amber-500"></i> Top Bác Sĩ Nhiều Lượt Khám Nhất
                    </h3>
                    <a asp-action="BaoCao" class="text-xs text-teal-600 hover:underline font-semibold">Xem chi tiết</a>
                </div>

                <div class="space-y-3">
                    @if (Model.TopBacSi.Any())
                    {
                        @foreach (var bs in Model.TopBacSi)
                        {
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-slate-100/80 transition">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-700 font-bold flex items-center justify-center text-sm">
                                        <i class="fa-solid fa-user-doctor"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-slate-800 text-sm">@bs.TenBacSi</h4>
                                        <span class="text-xs text-slate-500">Chuyên khoa: @bs.ChuyenKhoa</span>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="text-base font-extrabold text-teal-700">@bs.SoLuotKham</span>
                                    <span class="text-xs text-slate-400 block">lượt khám</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-400 py-6 text-center">Chưa có dữ liệu lượt khám hoàn tất.</p>
                    }
                </div>
            </div>

        </div>

        <!-- Bảng Lịch hẹn gần đây -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left text-teal-600"></i> Lịch Hẹn Đăng Ký Mới Nhất
                </h3>
                <a asp-controller="KhamBenh" asp-action="Index" class="text-xs text-teal-600 hover:underline font-semibold">
                    Xem tất cả lịch hẹn <i class="fa-solid fa-arrow-right ml-1"></i>
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full text-left text-xs divide-y divide-slate-100">
                    <thead class="bg-slate-50 font-bold text-slate-600 uppercase">
                        <tr>
                            <th class="py-3 px-4">Mã LH</th>
                            <th class="py-3 px-4">Bệnh nhân</th>
                            <th class="py-3 px-4">Bác sĩ</th>
                            <th class="py-3 px-4">Ngày giờ</th>
                            <th class="py-3 px-4 text-center">Trạng thái</th>
                            <th class="py-3 px-4 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.LichHenGanDay)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-3 px-4 font-bold text-slate-800">@item.MaLichHen</td>
                                <td class="py-3 px-4 font-semibold text-slate-800">@item.BenhNhan?.HoTen</td>
                                <td class="py-3 px-4 text-slate-600">@item.BacSi?.HoTen</td>
                                <td class="py-3 px-4 text-slate-600">@item.GioKham.ToString(@"hh\:mm") - @item.NgayKham.ToString("dd/MM/yyyy")</td>
                                <td class="py-3 px-4 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold 
                                          @(item.TrangThai == "Hoàn tất" ? "bg-emerald-100 text-emerald-800" :
                                            item.TrangThai == "Đã hủy" ? "bg-rose-100 text-rose-800" :
                                            item.TrangThai == "Đã tiếp nhận" ? "bg-purple-100 text-purple-800" :
                                            item.TrangThai == "Đã xác nhận" ? "bg-blue-100 text-blue-800" : "bg-amber-100 text-amber-800")">
                                        @item.TrangThai
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <a asp-controller="KhamBenh" asp-action="ChiTiet" asp-route-id="@item.MaLichHen" 
                                       class="text-teal-600 hover:text-teal-800 font-semibold">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
    // Biểu đồ Donut Tỷ lệ trạng thái
    const ctxLich = document.getElementById('chartTyLeLich').getContext('2d');
    new Chart(ctxLich, {
        type: 'doughnut',
        data: {
            labels: ['Hoàn tất', 'Đã tiếp nhận', 'Đã xác nhận', 'Chờ xác nhận', 'Đã hủy'],
            datasets: [{
                data: [
                    @Model.SoLichHoanTat, 
                    @Model.SoLichDaTiepNhan, 
                    @Model.SoLichDaXacNhan, 
                    @Model.SoLichChoXacNhan, 
                    @Model.SoLichDaHuy
                ],
                backgroundColor: ['#10b981', '#a855f7', '#3b82f6', '#f59e0b', '#f43f5e'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
            },
            cutout: '65%'
        }
    });
</script>
