@model QuanLyPhongKham.Models.ViewModels.ThongKeViewModel

@{
    ViewData["Title"] = "Báo cáo Thống kê LINQ Y tế";
}

<div class="container-fluid mt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-1">📈 Báo Cáo & Thống Kê Dữ Liệu (LINQ)</h2>
            <p class="text-muted mb-0">Module 4 - Mục 8.6: Truy vấn tổng hợp chuyên sâu bằng ngôn ngữ LINQ trên nền tảng Entity Framework Core</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary">
                🖨️ In báo cáo
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary">
                📊 Dashboard
            </a>
        </div>
    </div>

    <!-- HÀNG 1: 1. LỊCH THEO CHUYÊN KHOA & 5. TỶ LỆ HOÀN TẤT / HỦY -->
    <div class="row g-4 mb-4">
        <!-- 1. Lịch theo chuyên khoa -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        1️⃣ Thống kê Lịch khám theo Chuyên khoa
                    </h5>
                    <small class="text-muted">LINQ: GroupBy ChuyenKhoa ➔ Count() & Tính tỷ lệ %</small>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-5 mb-3 mb-md-0">
                            <canvas id="chartChuyenKhoa" style="max-height: 220px;"></canvas>
                        </div>
                        <div class="col-md-7">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Chuyên khoa</th>
                                            <th class="text-center">Số lịch</th>
                                            <th class="text-end">Tỷ lệ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ck in Model.LichTheoChuyenKhoa)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@ck.TenChuyenKhoa</td>
                                                <td class="text-center fw-bold text-primary">@ck.SoLuongLich</td>
                                                <td class="text-end">
                                                    <span class="badge bg-primary bg-opacity-10 text-primary">@ck.TiLePhanTram%</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Tỷ lệ hoàn tất / Hủy -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-success">
                        5️⃣ Thống kê Tỷ lệ Hoàn tất / Hủy lịch
                    </h5>
                    <small class="text-muted">LINQ: Đếm theo nhóm trạng thái 'Hoàn tất', 'Đã hủy', 'Đang xử lý'</small>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-5 mb-3 mb-md-0">
                            <canvas id="chartTyLe" style="max-height: 220px;"></canvas>
                        </div>
                        <div class="col-md-7">
                            <div class="list-group list-group-flush">
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <span class="badge bg-success p-2 me-2">●</span>
                                        <strong>Hoàn tất khám & thu tiền:</strong>
                                    </div>
                                    <span class="fw-bold text-success fs-6">
                                        @Model.TyLeHoanTatHuy.HoanTat ca (@Model.TyLeHoanTatHuy.TiLeHoanTat%)
                                    </span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <span class="badge bg-danger p-2 me-2">●</span>
                                        <strong>Lịch đã hủy (có lưu lý do):</strong>
                                    </div>
                                    <span class="fw-bold text-danger fs-6">
                                        @Model.TyLeHoanTatHuy.DaHuy ca (@Model.TyLeHoanTatHuy.TiLeHuy%)
                                    </span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <span class="badge bg-warning p-2 me-2">●</span>
                                        <strong>Đang tiếp nhận / chờ khám:</strong>
                                    </div>
                                    <span class="fw-bold text-warning-emphasis fs-6">
                                        @Model.TyLeHoanTatHuy.DangXuLy ca (@Model.TyLeHoanTatHuy.TiLeDangXuLy%)
                                    </span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0 border-top pt-2">
                                    <span class="fw-bold text-muted">Tổng số lượt lịch hẹn:</span>
                                    <span class="fw-bold fs-5 text-dark">@Model.TyLeHoanTatHuy.TongLichHen ca</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 2: 2. BÁC SĨ NHIỀU LƯỢT KHÁM & 3. DỊCH VỤ DÙNG NHIỀU -->
    <div class="row g-4 mb-4">
        <!-- 2. Bác sĩ nhiều lượt khám -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-info">
                        2️⃣ Bác sĩ có nhiều lượt khám nhất (Top bác sĩ)
                    </h5>
                    <small class="text-muted">LINQ: GroupBy BacSi ➔ Count() ➔ OrderByDescending</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">Hạng</th>
                                    <th>Bác sĩ</th>
                                    <th>Chuyên khoa</th>
                                    <th class="text-end pe-3">Số ca khám</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.BacSiNhieuLuotKham.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu ca khám hoàn tất.</td>
                                    </tr>
                                }
                                @{ int rank = 1; }
                                @foreach (var bs in Model.BacSiNhieuLuotKham)
                                {
                                    <tr>
                                        <td>
                                            @if (rank == 1) { <span class="badge bg-warning text-dark fs-6">🥇 1</span> }
                                            else if (rank == 2) { <span class="badge bg-secondary fs-6">🥈 2</span> }
                                            else if (rank == 3) { <span class="badge bg-danger bg-opacity-75 fs-6">🥉 3</span> }
                                            else { <span class="badge bg-light text-dark border">#@rank</span> }
                                        </td>
                                        <td class="fw-bold text-dark">@bs.HoTen</td>
                                        <td><span class="badge bg-light text-primary border">@bs.ChuyenKhoa</span></td>
                                        <td class="text-end pe-3 fw-bold text-success fs-6">@bs.SoLuotKham ca</td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Dịch vụ dùng nhiều -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-danger">
                        3️⃣ Dịch vụ y tế được sử dụng nhiều nhất
                    </h5>
                    <small class="text-muted">LINQ: GroupBy ChiTietDichVu ➔ Sum(SoLuong) ➔ Sum(ThanhTien)</small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên dịch vụ y tế</th>
                                    <th class="text-center">Số lần dùng</th>
                                    <th class="text-end pe-3">Doanh thu mang lại</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.DichVuDungNhieu.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu sử dụng dịch vụ.</td>
                                    </tr>
                                }
                                @foreach (var dv in Model.DichVuDungNhieu)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@dv.TenDichVu</div>
                                            <small class="text-muted">Mã DV: @dv.MaDichVu</small>
                                        </td>
                                        <td class="text-center fw-bold text-primary">
                                            @dv.SoLanSuDung lượt
                                        </td>
                                        <td class="text-end pe-3 fw-bold text-danger">
                                            @dv.TongDoanhThu.ToString("N0") VNĐ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 3: 4. DOANH THU THEO THÁNG & 6. BỆNH NHÂN THEO THÁNG -->
    <div class="row g-4 mb-4">
        <!-- 4. Doanh thu theo tháng -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-success">
                        4️⃣ Doanh thu phòng khám theo Tháng
                    </h5>
                    <small class="text-muted">LINQ: ThanhToans.GroupBy(t => new { t.Year, t.Month }) ➔ Sum(SoTien)</small>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <canvas id="chartDoanhThu" style="max-height: 250px;"></canvas>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Thời gian</th>
                                    <th class="text-center">Số giao dịch</th>
                                    <th class="text-end pe-3">Doanh thu thu về</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dt in Model.DoanhThuTheoThang)
                                {
                                    <tr>
                                        <td class="fw-bold">@dt.NhanThoiGian</td>
                                        <td class="text-center">@dt.SoLuotThanhToan HĐ</td>
                                        <td class="text-end pe-3 fw-bold text-success">@dt.DoanhThu.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Bệnh nhân theo tháng -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        6️⃣ Số lượng Bệnh nhân khám theo Tháng
                    </h5>
                    <small class="text-muted">LINQ: LichHens.GroupBy(l => new { l.Year, l.Month }) ➔ Distinct BenhNhan</small>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <canvas id="chartBenhNhan" style="max-height: 250px;"></canvas>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Thời gian</th>
                                    <th class="text-end pe-3">Số lượng bệnh nhân đến khám</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bn in Model.BenhNhanTheoThang)
                                {
                                    <tr>
                                        <td class="fw-bold">@bn.NhanThoiGian</td>
                                        <td class="text-end pe-3 fw-bold text-primary">@bn.SoBenhNhanKham người</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Biểu đồ tròn: Lịch theo chuyên khoa
        var ctxCK = document.getElementById('chartChuyenKhoa').getContext('2d');
        var labelsCK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LichTheoChuyenKhoa.Select(x => x.TenChuyenKhoa)));
        var dataCK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LichTheoChuyenKhoa.Select(x => x.SoLuongLich)));
        new Chart(ctxCK, {
            type: 'doughnut',
            data: {
                labels: labelsCK,
                datasets: [{
                    data: dataCK,
                    backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6f42c1', '#0dcaf0']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 5. Biểu đồ tròn: Tỷ lệ Hoàn tất / Hủy
        var ctxTyLe = document.getElementById('chartTyLe').getContext('2d');
        new Chart(ctxTyLe, {
            type: 'doughnut',
            data: {
                labels: ['Hoàn tất', 'Đã hủy', 'Đang xử lý'],
                datasets: [{
                    data: [@Model.TyLeHoanTatHuy.HoanTat, @Model.TyLeHoanTatHuy.DaHuy, @Model.TyLeHoanTatHuy.DangXuLy],
                    backgroundColor: ['#198754', '#dc3545', '#ffc107']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 4. Biểu đồ đường: Doanh thu theo tháng
        var ctxDT = document.getElementById('chartDoanhThu').getContext('2d');
        var labelsDT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThang.Select(x => x.NhanThoiGian)));
        var dataDT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThang.Select(x => x.DoanhThu)));
        new Chart(ctxDT, {
            type: 'line',
            data: {
                labels: labelsDT,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: dataDT,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        ticks: {
                            callback: function(val) { return val.toLocaleString('vi-VN') + ' đ'; }
                        }
                    }
                }
            }
        });

        // 6. Biểu đồ cột: Bệnh nhân theo tháng
        var ctxBN = document.getElementById('chartBenhNhan').getContext('2d');
        var labelsBN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BenhNhanTheoThang.Select(x => x.NhanThoiGian)));
        var dataBN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BenhNhanTheoThang.Select(x => x.SoBenhNhanKham)));
        new Chart(ctxBN, {
            type: 'bar',
            data: {
                labels: labelsBN,
                datasets: [{
                    label: 'Số bệnh nhân',
                    data: dataBN,
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}
