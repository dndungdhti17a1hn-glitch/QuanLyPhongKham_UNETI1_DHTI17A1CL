@model QuanLyPhongKham.Models.ViewModels.DatLichViewModel

@{
    ViewData["Title"] = "Đặt lịch khám bệnh";
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-cyan-50/30 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Back button -->
        <a asp-action="Index" class="inline-flex items-center text-teal-600 hover:text-teal-700 font-semibold mb-6 transition">
            <i class="fa-solid fa-arrow-left mr-2"></i>Quay lại danh sách lịch hẹn
        </a>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Form Column (2/3) -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white text-2xl">
                            <i class="fa-solid fa-calendar-plus"></i>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-slate-900">Đặt Lịch Khám Mới</h2>
                            <p class="text-sm text-slate-600">Điền đầy đủ thông tin để đặt lịch khám</p>
                        </div>
                    </div>
                    
                    <form asp-action="DatLich" method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl text-sm"></div>

                        <!-- Chọn Bác sĩ -->
                        <div>
                            <label asp-for="MaBacSi" class="block text-sm font-semibold text-slate-700 mb-2">
                                <i class="fa-solid fa-user-doctor text-teal-600 mr-2"></i>Chọn Bác Sĩ <span class="text-red-500">*</span>
                            </label>
                            <select asp-for="MaBacSi" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-transparent transition"
                                    asp-items="@(new SelectList(ViewBag.DanhSachBacSi, "MaBacSi", "HoTen"))">
                                <option value="">-- Chọn bác sĩ khám --</option>
                            </select>
                            <span asp-validation-for="MaBacSi" class="text-red-600 text-xs mt-1 block"></span>
                        </div>

                        <!-- Chọn Phòng khám -->
                        <div>
                            <label asp-for="MaPhong" class="block text-sm font-semibold text-slate-700 mb-2">
                                <i class="fa-solid fa-hospital text-teal-600 mr-2"></i>Chọn Phòng Khám <span class="text-red-500">*</span>
                            </label>
                            <select asp-for="MaPhong" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-transparent transition"
                                    asp-items="@(new SelectList(ViewBag.DanhSachPhong, "MaPhong", "TenPhong"))">
                                <option value="">-- Chọn phòng khám --</option>
                            </select>
                            <span asp-validation-for="MaPhong" class="text-red-600 text-xs mt-1 block"></span>
                        </div>

                        <!-- Row: Ngày + Giờ -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label asp-for="NgayKham" class="block text-sm font-semibold text-slate-700 mb-2">
                                    <i class="fa-solid fa-calendar text-teal-600 mr-2"></i>Ngày Khám <span class="text-red-500">*</span>
                                </label>
                                <input asp-for="NgayKham" type="date" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-transparent transition" />
                                <span asp-validation-for="NgayKham" class="text-red-600 text-xs mt-1 block"></span>
                                <p class="text-xs text-slate-500 mt-1">Đặt lịch trước ít nhất 1 ngày</p>
                            </div>
                            <div>
                                <label asp-for="GioKham" class="block text-sm font-semibold text-slate-700 mb-2">
                                    <i class="fa-solid fa-clock text-teal-600 mr-2"></i>Giờ Khám <span class="text-red-500">*</span>
                                </label>
                                <input asp-for="GioKham" type="time"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-transparent transition" />
                                <span asp-validation-for="GioKham" class="text-red-600 text-xs mt-1 block"></span>
                                <p class="text-xs text-slate-500 mt-1">Giờ làm việc: 7:00 - 20:00</p>
                            </div>
                        </div>

                        <!-- Lý do khám -->
                        <div>
                            <label asp-for="LyDoKham" class="block text-sm font-semibold text-slate-700 mb-2">
                                <i class="fa-solid fa-notes-medical text-teal-600 mr-2"></i>Lý Do Khám Bệnh <span class="text-red-500">*</span>
                            </label>
                            <textarea asp-for="LyDoKham" rows="4" placeholder="Mô tả triệu chứng hoặc lý do khám bệnh của bạn..."
                                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-500 focus:border-transparent transition resize-none"></textarea>
                            <span asp-validation-for="LyDoKham" class="text-red-600 text-xs mt-1 block"></span>
                        </div>

                        <!-- Submit buttons -->
                        <div class="flex flex-col sm:flex-row gap-4 pt-4">
                            <button type="submit" class="flex-1 px-6 py-3 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold shadow-lg shadow-teal-500/30 transition transform hover:-translate-y-0.5">
                                <i class="fa-solid fa-paper-plane mr-2"></i>Gửi Yêu Cầu Đặt Lịch
                            </button>
                            <a asp-action="Index" class="px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition text-center">
                                <i class="fa-solid fa-times mr-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info Cards Column (1/3) -->
            <div class="space-y-6">
                <!-- Card: Lưu ý -->
                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
                    <h4 class="font-bold text-amber-900 mb-4 flex items-center text-lg">
                        <i class="fa-solid fa-exclamation-triangle mr-2"></i>Lưu Ý Quan Trọng
                    </h4>
                    <ul class="text-sm text-amber-800 space-y-3">
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-amber-600 mr-2 mt-0.5"></i>
                            <span>Đặt lịch trước ít nhất <strong>1 ngày</strong></span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-amber-600 mr-2 mt-0.5"></i>
                            <span>Giờ làm việc: <strong>7:00 - 20:00</strong></span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-amber-600 mr-2 mt-0.5"></i>
                            <span>Mang theo CCCD và thẻ BHYT (nếu có)</span>
                        </li>
                        <li class="flex items-start">
                            <i class="fa-solid fa-check text-amber-600 mr-2 mt-0.5"></i>
                            <span>Đến trước <strong>15 phút</strong> so với giờ hẹn</span>
                        </li>
                    </ul>
                </div>

                <!-- Card: Hotline -->
                <div class="bg-gradient-to-br from-teal-500 to-cyan-600 text-white rounded-2xl p-6">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-2xl">
                            <i class="fa-solid fa-phone-volume"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-lg">Cần Hỗ Trợ?</h4>
                            <p class="text-sm opacity-90">Hotline 24/7</p>
                        </div>
                    </div>
                    <a href="tel:1900888999" class="block w-full px-4 py-3 rounded-xl bg-white/20 hover:bg-white/30 text-center font-bold text-2xl tracking-wide transition">
                        1900 888 999
                    </a>
                    <p class="text-xs opacity-75 mt-3 text-center">Miễn phí tư vấn và hỗ trợ đặt lịch</p>
                </div>

                <!-- Card: Quy trình -->
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
                    <h4 class="font-bold text-slate-900 mb-4 flex items-center">
                        <i class="fa-solid fa-list-check text-teal-600 mr-2"></i>Quy Trình Khám
                    </h4>
                    <ol class="text-sm text-slate-700 space-y-3">
                        <li class="flex items-start">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center text-xs font-bold mr-3">1</span>
                            <span>Đặt lịch online</span>
                        </li>
                        <li class="flex items-start">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center text-xs font-bold mr-3">2</span>
                            <span>Nhận xác nhận qua SMS/Email</span>
                        </li>
                        <li class="flex items-start">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center text-xs font-bold mr-3">3</span>
                            <span>Đến phòng khám đúng giờ</span>
                        </li>
                        <li class="flex items-start">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center text-xs font-bold mr-3">4</span>
                            <span>Khám bệnh và nhận kết quả</span>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
