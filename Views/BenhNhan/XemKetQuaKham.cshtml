@model QuanLyPhongKham.Models.PhieuKham

@{
    ViewData["Title"] = "Kết quả khám bệnh";
    decimal tongTien = Model.ChiTietDichVus.Sum(c => c.ThanhTien);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📋 Kết quả Khám Bệnh & Đơn dịch vụ</h2>
        <div>
            <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ In kết quả</button>
            <a asp-action="Index" class="btn btn-primary">⬅ Lịch sử khám</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="row pb-3 mb-4 border-bottom">
                <div class="col-8">
                    <h4 class="text-primary fw-bold">PHÒNG KHÁM ĐA KHOA QUỐC TẾ UNETI</h4>
                    <p class="text-muted small mb-0">218 Lĩnh Nam, Hoàng Mai, Hà Nội | Hotline: 1900 6868</p>
                </div>
                <div class="col-4 text-end">
                    <h5 class="fw-bold text-dark">KẾT QUẢ KHÁM BỆNH</h5>
                    <small class="text-muted">Mã phiếu: @Model.MaPhieuKham</small><br />
                    <small class="text-muted">Ngày khám: @Model.NgayKham.ToString("dd/MM/yyyy")</small>
                </div>
            </div>

            <div class="row g-3 mb-4 p-3 bg-light rounded">
                <div class="col-md-4">
                    <strong>Bệnh nhân:</strong> @Model.LichHen?.BenhNhan?.HoTen
                </div>
                <div class="col-md-4">
                    <strong>Số điện thoại:</strong> @Model.LichHen?.BenhNhan?.SoDienThoai
                </div>
                <div class="col-md-4">
                    <strong>Bác sĩ khám:</strong> @Model.LichHen?.BacSi?.HoTen
                </div>
            </div>

            <div class="mb-4">
                <h6 class="text-primary fw-bold">🩺 Chẩn đoán của bác sĩ:</h6>
                <div class="p-3 bg-white border rounded">
                    @Model.ChanDoan
                </div>
            </div>

            <div class="mb-4">
                <h6 class="text-success fw-bold">📋 Kết luận & Hướng dẫn điều trị:</h6>
                <div class="p-3 bg-white border rounded">
                    @Model.KetLuan
                </div>
            </div>

            <div class="mb-4">
                <h6 class="text-dark fw-bold">💉 Dịch vụ kỹ thuật đã thực hiện:</h6>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Tên dịch vụ</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dv in Model.ChiTietDichVus)
                        {
                            <tr>
                                <td>@dv.DichVuKham?.TenDichVu</td>
                                <td class="text-center">@dv.SoLuong</td>
                                <td class="text-end">@dv.DonGia.ToString("N0") đ</td>
                                <td class="text-end fw-bold">@dv.ThanhTien.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Tổng tiền viện phí:</th>
                            <th class="text-end text-danger fw-bold fs-5">@tongTien.ToString("N0") VNĐ</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="p-3 rounded @(Model.ThanhToan != null && Model.ThanhToan.TrangThai == "Đã thanh toán" ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning-emphasis")">
                <strong>Trạng thái thanh toán: </strong>
                @(Model.ThanhToan != null && Model.ThanhToan.TrangThai == "Đã thanh toán" ? "Đã thanh toán đầy đủ (" + Model.ThanhToan.PhuongThuc + ")" : "Chưa thanh toán")
            </div>
        </div>
    </div>
</div>
